   <string notr="true">QWidget {
    background-color: #f5f5f5;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 10pt;
}

QHeaderView::section {
    background-color: #2c3e50;
    color: white;
    padding: 8px;
    border: none;
    font-weight: bold;
}

QTableWidget {
    background-color: white;
    alternate-background-color: #f8f9fa;
    gridline-color: #dfe6e9;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
}

QTableWidget::item {
    padding: 5px;
}

QTableWidget::item:selected {
    background-color: #3498db;
    color: white;
}

QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #1f618d;
}

QPushButton#btn_Desactiver {
    background-color: #e74c3c;
}

QPushButton#btn_Desactiver:hover {
    background-color: #c0392b;
}

QPushButton#btn_Activer {
    background-color: #27ae60;
}

QPushButton#btn_Activer:hover {
    background-color: #1e8449;
}

QLineEdit {
    padding: 8px;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    background-color: white;
}

QLineEdit:focus {
    border: 2px solid #3498db;
}

QGroupBox {
    border: 1px solid #bdc3c7;
    border-radius: 8px;
    margin-top: 10px;
    font-weight: bold;
    background-color: white;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QComboBox {
    padding: 8px;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    background-color: white;
}</string>
