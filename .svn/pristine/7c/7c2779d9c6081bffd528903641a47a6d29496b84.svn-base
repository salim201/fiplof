    def hasGeom(self, gid):
        cur = self.connection.cursor()
        try:
            cur.execute("SELECT geom FROM parcelle_d WHERE gid = %s and geom IS NOT NULL", (gid,))
            res = cur.fetchone()
            if res is not None:
                return len(res) > 0
            else:
                return False
        except Exception as err:
            print "Erreur Has Geom " + str(err)
            self.connection.rollback()
            return  False
