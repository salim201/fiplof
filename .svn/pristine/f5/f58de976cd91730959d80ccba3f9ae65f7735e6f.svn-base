                        demandeurExiste = True
                        #self.connection.rollback()

                    self.connection.rollback()

                if demandeurExiste:
                    try:
                        self.cur.execute(
                            "UPDATE proprietaireparcelle SET representant = %s WHERE idparcelle = %s AND idpersonne = %s",
