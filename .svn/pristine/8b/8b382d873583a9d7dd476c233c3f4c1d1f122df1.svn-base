	</table>

	<table style="font-size:9px" class="fullwidth border-all border-collapse">

			<p style="margin-left:2%">II- MOMBAMOMBA NY TANY</p>
    	<tr>
			<th colspan="2">Toerana misy ny tany</th>
			<th colspan="2">Mamaritra ny tany</th>
			<th colspan="3">Habeny </th>
			<th colspan="5">VESATRA SY ZO VOALOHANY </th>
		</tr>
		<tr >
			<th colspan="1" style="text-align: left;font-size:8px">FARITRA</th>
			<th colspan="1"></th>
			<th colspan="1" style="text-align: left;font-size:8px">ANTSINANA</th>
			<th colspan="1"></th>
			<th colspan="1">Ha </th>
			<th colspan="1">a </th>
			<th colspan="1">ca </th>
			<th colspan="5" rowspan="5"></th>
		</tr>
		<tr style="text-align: left;font-size:8px">
			<th colspan="1">DISTRIKA</th>
			<th colspan="1"></th>
			<th colspan="1">ANDREFANA</th>
			<th colspan="1"></th>
			<th colspan="1" rowspan="4"> </th>
			<th colspan="1" rowspan="4"> </th>
			<th colspan="1" rowspan="4"></th>
		</tr>
		<tr style="text-align: left;font-size:8px">
			<th colspan="1">KAOMININA</th>
			<th colspan="1"></th>
			<th colspan="1">AVARATRA</th>
			<th colspan="1"></th>
		</tr>
		<tr style="text-align: left;font-size:8px">
			<th colspan="1">FOKONTANY</th>
			<th colspan="1"></th>
			<th colspan="1">ANTSIMO</th>
			<th colspan="1"></th>
		</tr>
		<tr style="text-align: left;font-size:8px">
			<th colspan="1">TANANA</th>
			<th colspan="1"></th>
			<th colspan="2"></th>
		</tr>
	</table>
	<br/>
	<table style="font-size:9px" class="fullwidth border-all border-collapse">
		<tr>
			<th colspan="1">Noraiketina tato anaty Regisitry ny Tany sy nankatoavina androany faha:_______________________________</th>

			<th colspan="1">Karatany voaray androany fara:_______________________________________</th>
		</tr>
		<tr>
			<th colspan="1" style="height:80px;vertical-align: text-bottom;">Ny Ben'ny tanàna (<I>ampiarahna ny anarana sy ny sonia ary fitomboka mena sy fitomboka maina an'i Birao Ifoton'ny Fananan-tany eo an-toerana</I>)</th>

			<th colspan="1" style="height:80px;vertical-align: text-bottom">Ny nandray ny Karatany (<i>Ampiarahana sonia sy anaran'ny mpanao sonia</i>)</th>
		</tr>
	</table>
	<br/>
	<table>
		<tr style="margin-buttom:1%">
			<th colspan="2">Tsy maintsy hamarinin'ny solotenam-panjakana ny isan' ny pejy</th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>
			<th colspan="2"></th>

			<th colspan="2"> Pejy:__________/____________</th>
		</tr>
	</table>
	<p></p>
</body>
</html>
