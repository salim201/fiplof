try:
    _fromUtf8 = QtCore.QString.fromUtf8
except AttributeError:
    def _fromUtf8(s):
        return s

try:
    _encoding = QtGui.QApplication.UnicodeUTF8
    def _translate(context, text, disambig):
        return QtGui.QApplication.translate(context, text, disambig, _encoding)
except AttributeError:
    def _translate(context, text, disambig):
        return QtGui.QApplication.translate(context, text, disambig)

class AutoRestoreRun(Qt.QDialog):
    def __init__(self,parent,connection, exetype='pg_restore'):
        QtGui.QDialog.__init__(self)
        # Set up the user interface from Designer.
        self.ui = Ui_AutoSaveUI()
        self.ui.setupUi(self)
        self.parent = parent
        self.connection = connection
        self.cursor = self.connection.cursor()
        self.thread = None
        self.LOGIN = ''
        self.PASSWORD = ''
        self.FILESAVE = ''
        self.CURRENT_DB = ''
        self.CURRENT_USER = ''
        self.NOM_BASE = None
        self.output = []
        self.type = exetype
        self.dirname = os.path.expanduser('~')
        self.setWindowTitle("Restoration automatique de la base de données")
        self.ui.label.setText("Restoration automatique de la base de données en cours!Veuillez patienter! ")
        self.filename = None
        self.db_config = DbConfig.DbConfig()
        self.launch()


    def get_pgdump_path(self):
        setting = None
        cursor = self.connection.cursor(cursor_factory=psycopg2.extras.DictCursor)
        try:
            cursor.execute("SELECT setting FROM pg_settings where name like 'data_directory'")
            row = cursor.fetchone()
            setting = row["setting"]
        except Exception as e:
            print(e)
        cursor.close()
        if setting is None:
            return None
        b = os.path.dirname(setting)
        return str(os.path.join(b, "bin\\%s.exe" % self.type))


    def launch(self):
        # id_projet = int(globalvars.id_projet)
        if self.dirname == "":
            return
        print("launch on")
        pgdump = self.get_pgdump_path()
        print ("****pgdump******")
        print (pgdump)
        # self.message_added("Recuperation de l'executable %s" % self.type)

        try:
            self.myThread = AutoRestoreThread(pgdump=pgdump, dirname=self.dirname, connection=self.connection, parent=self)
        except Exception as err:
            print(err)
        self.progress(30)

        try:
            self.myThread.doneSignal.connect(self.termine)
            self.myThread.errorAddedSignal.connect(self.showError)
            print("AFTER CONNECTING TO TERMINE")
        except Exception as err:
            print(err)
        self.progress(60)
        try:
            self.myThread.start()
        except Exception as err:
            print(err)

    def termine(self):
        self.progress(100)
        QtGui.QMessageBox.information(
            self,
            "Termine",
            "L'export automatique de la base est termine" if self.type == "pg_dump" else
            "La restoration automatique de la base est termine\nL'application va maintenant se fermer.")
        #subprocess.Popen(r'explorer /select,' + self.filename + '')
        self.close()
        sys.exit()

    def showError(self, m):
        #self.progress(100)
        QtGui.QMessageBox.critical(
            self,
            "Erreur",
            "Erreur " + m )
        #subprocess.Popen(r'explorer /select,' + self.filename + '')
        self.close()

    def progress(self, p):
        self.ui.progressBar.setValue(p)