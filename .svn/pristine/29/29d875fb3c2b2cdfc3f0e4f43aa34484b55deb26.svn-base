    def selGeometry(self):
        canvas = self.cv1
        for layer in canvas.layers():
            print " in layer loop in "
            if layer.type() == layer.VectorLayer:
                layer.removeSelection()

        canvas.refresh()
        self.previewLayer.select(int(self.geomId))
        self.newGeom = int(self.geomId)
        self.cv1.zoomToSelected(self.previewLayer)
        self.cv1.refresh()
        #self.previewLayer.select(int(self.OtherGeomId))


    def selGeometrySuivant(self):
        canvas = self.cv1
        for layer in canvas.layers():
            print " in layer loop in "
            if layer.type() == layer.VectorLayer:
                layer.removeSelection()

        canvas.refresh()
        self.previewLayer.select(int(self.OtherGeomId))
        self.newGeom = int(self.OtherGeomId)
        self.cv1.zoomToSelected(self.previewLayer)
        self.cv1.refresh()
    def calculateArea(self,geom):
        print "area calculate"
        print geom
        connection = self.connection
        cursor = connection.cursor()
        exe = cursor.execute(
            "UPDATE parcelle_d set surface = ST_Area(%s) WHERE gid = %s returning gid",
            (int(geom)))
        connection.commit()

