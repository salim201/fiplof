        opp = VoisinsRun(self)
        opp.show()
        result = opp.exec_()

    def ChargerAncienLimites(self,ancienCF):
        cursor = self.connection.cursor()
        try :
            cursor.execute(" select lm.idpointscardinaux, lm.idparcelle, lm.description , pc.position from limitesparcelle as lm "
                           " inner join parcelle_d as pd on lm.idparcelle = pd.gid "
                           " inner join pointscardinaux as pc on pc.idpointscardinaux = lm.idpointscardinaux "
                           " inner join certificat as  cf on cf.numerodemande = pd.numdemande"
                           " where cf.numerocertificat   = %s", [str(ancienCF)])
            row = cursor.fetchall()

        except Exception as e:
            print(e)

        self.isVoisin = 0

        rowPosition = self.ui.tableWidget_5.rowCount()
        print('VOISIN DATA')
        try:
            if (len(row) >= 1):
                for d in row:
                    data = (str(d[3]), str(d[2]), int(d[1]), int(d[0]))
                    print("DATA PAR LIGNE")
                    print(data)
                    #self.addVoisin(data)
                    columns = len(data)
                    rowPosition = self.ui.tableWidget_5.rowCount()
                    self.ui.tableWidget_5.setColumnCount(columns)
                    self.ui.tableWidget_5.insertRow(rowPosition)
                    i = 0
                    try:
                        for i in range(len(data)):
                            item = QtGui.QTableWidgetItem()
                            item.setText(_translate("", str(data[i]), None))
                            self.ui.tableWidget_5.setItem(rowPosition, i, item)
                    except StandardError as e:
                        print e

        except Exception as e:
            print(e)

