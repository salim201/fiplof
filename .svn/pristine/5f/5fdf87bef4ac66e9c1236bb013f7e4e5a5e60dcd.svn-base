    def refreshCanvas(self):

        canvas = self.parent.canvas
        for layer in canvas.layers():
            if layer.type() == layer.VectorLayer:
                layer.removeSelection()
                layer.triggerRepaint()
        canvas.refresh()

    def reloadCanvas(self):
        print " reload canvas "
        canvas = self.parent.canvas
        for layer in canvas.layers():
            if layer.type() == layer.VectorLayer:
                layer.removeSelection()
                layer.triggerRepaint()

        canvas.refresh()
    def loadConsistance(self, connexion):
        cursor = connexion.cursor()
        cursor.execute("SELECT *   FROM consistance")
        cs = cursor.fetchall()
        size = len(cs)
        if (size >= 1):
            consistance = cs[0]
            for row in cs:
                ligneconsistance = row[2]
                self.ui.comboBox.addItem(_fromUtf8(row[1]), row[0])
                self.ui.consistanceComboBox.addItem(_fromUtf8(row[1]), row[0])

    def loadRegionDistrictCommune(self, connexion, idregion, iddistrict, idcommune):
        cursor = connexion.cursor()
        cursor.execute("SELECT nomregion  FROM region  WHERE idregion=%s", [int(idregion)])
        dm = cursor.fetchone()
        if (len(dm) >= 1):
            region = dm[0]
            self.ui.lineEditRegion.setText(_fromUtf8(region))
            self.ui.lineEditRegion.setReadOnly(True)

        cursor.execute("SELECT *  FROM district  WHERE iddistrict=%s", [int(iddistrict)])
        dm = cursor.fetchone()
        if (len(dm) >= 1):
            coddistrict = dm[2]
            district = dm[3]
            self.coddistrict = coddistrict

        self.ui.lineEditDistrict.setText(_fromUtf8(district))
        self.ui.lineEditDistrict.setReadOnly(True)
        cursor.execute("SELECT *  FROM commune  WHERE idcommune=%s", [int(idcommune)])
        dm = cursor.fetchone()
        if (len(dm) >= 1):
            libelleCommune = dm[3]
            codeCommune = dm[2]
            self.codecommune = codeCommune
            self.ui.lineEditCommune.setText(_fromUtf8(libelleCommune))
            self.ui.lineEditCommune.setReadOnly(True)

    def loadCommune(self, connexion, idcommune,idregion, iddistrict):
        cursor = connexion.cursor()

        cf = self.infosCF()
        idfkt = cf[9]

        cursor.execute("SELECT *  FROM fokontany  WHERE idfokontany=%s", [int(idfkt)])
        res = cursor.fetchone()

        cursor.execute("SELECT *  FROM fokontany  WHERE idcommune=%s", [int(idcommune)])
        dm = cursor.fetchall()
        size = len(dm)
        if (size >= 1):
            district = dm[0]
            self.ui.comboFokontany.clear()
            for row in dm:
                lignefkt = row[3]
                self.ui.comboFokontany.addItem(_fromUtf8(row[3]), row[0])
                print
                lignefkt
        else:
            self.ui.comboFokontany.clear()

        self.ui.comboFokontany.setCurrentIndex(self.ui.comboFokontany.findText(str(res[3]).strip()))
        #self.ui.comboFokontany.setReadOnly(True)

        import globalvars
        # Recuperer le district
        try:
            self.cur.execute(
                "SELECT d.nomdistrict, d.iddistrict, d.codedistrict FROM district d, commune c WHERE d.iddistrict = c.iddistrict AND c.idcommune = %s",
                (globalvars.id_commune,))
            dist = self.cur.fetchone()
        except StandardError as e:
            print
            e
            # Recuperer le nom de la commune
        try:
            self.cur.execute("SELECT * FROM commune WHERE idcommune = %s",
                             (globalvars.id_commune,))
            com = self.cur.fetchone()
        except StandardError as e:
            print e
            currCert = None

        #
        try:
            self.cur.execute("SELECT MAX(idcertificat) FROM certificat")
            crt = self.cur.fetchone()
            currCert = crt[0] + 1
        except StandardError as e:
            print e
        if currCert is None:
            currCert = 1

        # Fokontany
        codefokontany = res[2]
        self.currentValCF = int(com[6])
        numCert = str(dist[2]).strip() +"-"+ str(com[2]).strip()  + "-KT-" + str(com[6]).strip()

        self.ui.numRoCertificatLineEdit.setText(numCert)
        self.ui.numRoCertificatLineEdit.setReadOnly(True)
        

