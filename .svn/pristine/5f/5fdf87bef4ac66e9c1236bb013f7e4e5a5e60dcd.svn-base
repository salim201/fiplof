                       " INNER  JOIN proprietaireparcelle phd ON  phd.idpersonne = ph.idpersonne "
                       " INNER  JOIN parcelle_d pc ON  phd.idparcelle = pc.gid "
                       " WHERE pc.gid = %s ",
                       [int(self.geomId)])
        rw = cursor.fetchone()

        rowPosition = self.ui.tableWidget.rowCount()
        self.ui.tableWidget.insertRow(rowPosition)
