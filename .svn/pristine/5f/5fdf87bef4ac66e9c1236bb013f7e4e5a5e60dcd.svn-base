        i = 1
        while j < len(rw):
            self.ui.tableWidget.setItem(rowPosition, j - 1, QTableWidgetItem(unicode(rw[j])))
            j = j + 1
        i = i + 1

    def load_raster(self):
        if self.raster_path is None:
            return
        fileInfo = QFileInfo(self.raster_path)
        baseName = fileInfo.baseName()
        layer = QgsRasterLayer(self.raster_path, baseName)
        if not layer.isValid():
            print("Layer " + self.raster_path + " is not valid raster")
            return None
        # QgsMapLayerRegistry.instance().addMapLayer(layer)
        self.layer_raster = layer
    def resolve(self, name, basepath=None):
        if not basepath:
            basepath = os.path.dirname(os.path.realpath(__file__))
        return os.path.join(basepath, name)

    def init_layers(self):
        couches = ProjetCouche.find_by_projet_commune(self.connection, globalvars.id_projet_commune)
        for couche in couches:
            if couche.type_couche == 'R':
                self.raster_path = couche.fichier
                break

    def init_canvas(self,geomId=None,OtherGeom = None):
        style = {
            u'outline_width': u'0.3',
            u'outline_color': u'244,0,0,255',
            u'offset_unit': u'MM',
            u'color': u'227,26,28,255',
            u'outline_style': u'solid',
            u'style': u'b_diagonal',
            u'joinstyle': u'bevel',
            u'outline_width_unit': u'MM',
            u'border_width_map_unit_scale': u'0,0',
            u'offset': u'0,0',
            u'offset_map_unit_scale': u'0,0'
        }
        self.cv = QgsMapCanvas()
        self.cv1 = QgsMapCanvas()

        #self.idparcelle;
        # add canvas  ad form
        self.ui.horizontalLayout.addWidget(self.cv)
        self.ui.horizontalLayout_2.addWidget(self.cv1)
        self.cv.show()
        self.cv1.show()

        uri = QgsDataSourceURI()
        #uri1 = QgsDataSourceURI()

        uri.setConnection(
            self.db_config.db_host,
            self.db_config.db_port,
            self.db_config.db_name,
            self.db_config.db_user,
            self.db_config.db_pass
        )
        where = "gid IN  (18600,18601)"
        #uri.setDataSource("public", "parcelle_d", "geom", where)
        print "self.OtherGeomId"
        print self.OtherGeomId

        print " self.geomId"
        print self.geomId
        uri.setDataSource("public", "parcelle_d", "geom", " gid  IN ("+str(self.geomId)+","+str(self.OtherGeomId)+")")
        #uri1.setDataSource("public", "parcelle_d", "geom", "gid=%s " % [(18601,)])
       # uri.setDataSource("public", "parcelle_d", "geom", "gid=%s" % (int(self.geomId),))
        uri.setKeyColumn("gid")
        layer = QgsVectorLayer(uri.uri(), "Demande", "postgres")
        self.previewLayer = layer
        layer.select(int(self.OtherGeomId))
        # cLayer.setSelectedFeatures(int(ID))
        self.cv.zoomToSelected(layer)
        self.cv1.zoomToSelected(layer)

        #layer1 = QgsVectorLayer(uri.uri(), "Demande", "postgres")

        if not layer.isValid():
            return
        crs = QgsCoordinateReferenceSystem(100583, QgsCoordinateReferenceSystem.EpsgCrsId)
        layer.setCrs(crs)
        symbol_layer = QgsFillSymbolV2.createSimple(style)
        layer.rendererV2().setSymbol(symbol_layer)
        QgsMapLayerRegistry.instance().addMapLayer(layer)
        QgsMapLayerRegistry.instance().addMapLayer(self.layer_raster)
        #QgsMapLayerRegistry.instance().addMapLayer(layer1)

        #QgsMapLayerRegistry.instance().addMapLayer(self.layer_raster)
        self.cv.setLayerSet([QgsMapCanvasLayer(layer),QgsMapCanvasLayer(self.layer_raster)])
        self.cv1.setLayerSet([QgsMapCanvasLayer(layer),QgsMapCanvasLayer(self.layer_raster)])
        #self.cv.setLayerSet([QgsMapCanvasLayer(layer), QgsMapCanvasLayer(self.layer_raster)])


        #self.cv.setLayerSet([QgsMapCanvasLayer(layer1)])

        #self.cv.setLayerSet([QgsMapCanvasLayer(layer), QgsMapCanvasLayer(self.layer_raster)])
        self.cv.setExtent(layer.extent())
        self.cv1.setExtent(layer.extent())



