    def RemoveNouvelleLimites(self):
        self.tbVoisin = self.ui.tableWidget_6
        self.tbVoisin = self.ui.tableWidget_6
        currentRWVoisin = self.ui.tableWidget_6.currentRow()

        rowCount = self.ui.tableWidget_6.rowCount()
        columnCount = self.ui.tableWidget_6.columnCount()
        cursor = self.connection.cursor()

        if currentRWVoisin == -1:
            QtGui.QMessageBox.critical(self.ui.tableDemande, "Erreur", "Veuillez entrer au moins choisir une ligne")
            return
        else :
            self.ui.tableWidget_6.removeRow(int(self.selectedRow1))

    def RemoveAncienLimites(self):
        self.tbVoisin = self.ui.tableWidget_5
        currentRWVoisin = self.ui.tableWidget_5.currentRow()

        rowCount = self.ui.tableWidget_5.rowCount()
        columnCount = self.ui.tableWidget_5.columnCount()
        cursor = self.connection.cursor()

        if currentRWVoisin == -1:
            QtGui.QMessageBox.critical(self.ui.tableDemande, "Erreur", "Veuillez entrer au moins choisir une ligne")
            return
        else :
            self.ui.tableWidget_5.removeRow(int(self.selectedRow))

    def ModifierAncienLimites(self):
        self.tbVoisin = self.ui.tableWidget_5
