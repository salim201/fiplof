CERTIFICATE_LAYER_NAME = "Certificats"
CURRENT_CERTIFICATE_LAYER_NAME = "Current_Certificate"

class LayerPreview(QtGui.QWidget):
    layersStyle = {
        u'outline_width': u'0.3',
        u'outline_color': u'244,0,0,255',
        u'offset_unit': u'MM',
        u'color': u'227,26,28,255',
        u'outline_style': u'solid',
        u'style': u'b_diagonal',
        u'joinstyle': u'bevel',
        u'outline_width_unit': u'MM',
        u'border_width_map_unit_scale': u'0,0',
        u'offset': u'0,0',
        u'offset_map_unit_scale': u'0,0'
    }
    certificateStyle = {
        u'outline_width': u'0.8',
        u'outline_color': u'244,0,0,255',
        u'offset_unit': u'MM',
        u'color': u'28,26,227,255',
        u'outline_style': u'solid',
        u'style': u'b_diagonal',
        u'joinstyle': u'bevel',
        u'outline_width_unit': u'MM',
        u'border_width_map_unit_scale': u'0,0',
        u'offset': u'0,0',
        u'offset_map_unit_scale': u'0,0'
    }
    titreStyles = {
        u'outline_width': u'0.5', u'outline_color': u'255,255,0,255', u'offset_unit': u'MM',
        u'color': u'255,255,0,75', u'outline_style': u'solid', u'style': u'b_fill',
        u'joinstyle': u'bevel', u'outline_width_unit': u'MM', u'border_width_map_unit_scale': u'0,0',
        u'offset': u'0,0', u'offset_map_unit_scale': u'0,0'
    }

    cadastreStyles = {
        u'outline_width': u'0.5', u'outline_color': u'0,191,255,255', u'offset_unit': u'MM',
        u'color': u'0,191,255,75', u'outline_style': u'solid', u'style': u'b_fill',
        u'joinstyle': u'bevel', u'outline_width_unit': u'MM', u'border_width_map_unit_scale': u'0,0',
        u'offset': u'0,0', u'offset_map_unit_scale': u'0,0'
    }

    demandefnStyles = {
        u'outline_width': u'0.5', u'outline_color': u'238,130,238,255', u'offset_unit': u'MM',
        u'color': u'238,130,238,75', u'outline_style': u'solid', u'style': u'b_fill',
        u'joinstyle': u'bevel', u'outline_width_unit': u'MM', u'border_width_map_unit_scale': u'0,0',
