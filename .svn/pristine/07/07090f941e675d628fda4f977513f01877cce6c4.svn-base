class CompareDbModel:
    dataTolog = []
    def __init__(self,connLocal,connRemote,bar_syncho):
        print '--connectDB Model--'
        self.bar=bar_syncho
        self.dataTolog = []
        self.current_value = bar_syncho.ui.progressBar.value()
        self.title = ["Connexion", "Table", "Activite", "Situation", "Erreur"]
