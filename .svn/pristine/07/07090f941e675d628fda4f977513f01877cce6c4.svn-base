    def get_tables_except_specified(self,connlocal, list_tables_spec_gf):
        try:
            cursor = connlocal.cursor()

            # Récupérer toutes les tables de la base de données (depuis la table information_schema.tables)
            cursor.execute("""
                SELECT table_name
                FROM information_schema.tables
                WHERE table_schema = 'public'  -- Remplace si nécessaire par ton schéma
                AND table_type = 'BASE TABLE';
            """)

            # Récupérer toutes les tables
            all_tables = cursor.fetchall()

            # Flatten list_tables_spec_gf pour la comparaison (par exemple, ['contribuable', 'fi_paiement_impot'])
            excluded_tables = [item[0] for item in list_tables_spec_gf]

            # Filtrer les tables à exclure
            tables_to_include = [table[0] for table in all_tables if table[0] not in excluded_tables]

            return tables_to_include

        except Exception as e:
            print("Erreur lors de la récupération des tables : ", e)
            return []

    def sync_datas_tables_for_delete(self, conn, tables_target, tables_source, table_spec_topo):
        self.bar.ui.label.setText(u" supression des  données")
        self.current_value += 10
        self.bar.ui.progressBar.setValue(self.current_value)
        cur = conn.cursor()
        try:
            to_delete = set(tables_target) - set(tables_source)
            if to_delete:
                print '+++++++++++++++++++to delete *************************'
                for element in to_delete:
                    print '+++++++++++++++++++ delete*************************'
                    print element
                    self.delete_data(conn, table_spec_topo, element[0])
                    self.dataTolog.append({"Connexion": 'Remote and Local_ delete', "Table": table_spec_topo, "Activite": element,
                                           "Situation": 'OK', "Erreur": ''})
                print '+++++++++++++++++++to delete fin *************************'
        except Exception as e:
            self.dataTolog.append(
                {"Connexion": 'Remote and Local delete', "Table": '', "Activite": u'tentative de sychronisation par suppression élément', "Situation": 'KO',
                 "Erreur": e.message})
            print("CompareDbModel sync_datas_tables_for_delete - Erreur lors de la synchronisation :", e)
            # En cas d'erreur, annuler la transaction
            '''try:
                conn.rollback()
                cur.close()
                conn.close()
            except Exception as e:
                print(e)
                print 'ce n est pas grave'''

    def sync_datas_tables_update_insert(self,conn, tables_target, tables_source,table_spec_topo):
        cur=conn.cursor()
        self.bar.ui.label.setText(u" update et insert des  données")
        self.current_value += 3
        self.bar.ui.progressBar.setValue(self.current_value)
        try:

            # Identifier les enregistrements à insérer, mettre à jour et supprimer
            to_insert = set(tables_source) - set(tables_target)
            to_update = set(tables_source).intersection(set(tables_target))
            # Affichage dans la console
            is_insert=True
            is_update=True
            if to_insert :
                for element in to_insert:
                    print '+++++++++++++++++++to_insert *************************'
                    self.bar.ui.label.setText(u"  insert des  données")
                    self.current_value += 10
                    self.bar.ui.progressBar.setValue(self.current_value)
                    is_insert=self.insert_data(conn, table_spec_topo, element)

                    self.dataTolog.append({"Connexion": 'Local_insertion', "Table": table_spec_topo, "Activite": element,
                                           "Situation": 'OK', "Erreur": ''})
                #modification sequence après insertion
                seq=self.get_current_sequence_value(conn,table_spec_topo)
                print '+++++++++++++++++++seq *************************'
                print seq
                self.checkSequence(conn,table_spec_topo,seq['columns_id'],seq['current_value'])
                print '+++++++++++++++++++to_insert fin*************************'
            if to_update:
                for element in to_update:
                    print '+++++++++++++++++++to_update *************************'
                    self.bar.ui.label.setText(u"update des  données")
                    self.current_value += 10
                    self.bar.ui.progressBar.setValue(self.current_value)
                    is_update=self.update_data(conn,table_spec_topo,element)
                    texte = "mise à jour :%s"%element[1]
                    #self.append_dataTolog(self,'Local', table_spec_topo, texte, 'OK', '')
                    self.dataTolog.append({"Connexion": 'Local_update', "Table": table_spec_topo,
                                           "Activite": texte, "Situation": 'OK',
                                           "Erreur": ''})
                # modification sequence après update
                seq=self.get_current_sequence_value(conn, table_spec_topo)
                print '+++++++++++++++++++seq *************************'
                self.checkSequence(conn,table_spec_topo, seq['columns_id'], seq['current_value'])
                print '+++++++++++++++++++to_update fin*************************'

            return is_insert or is_update

        except Exception as e:
            self.dataTolog.append({"Connexion": 'Local', "Table": '',
                                   "Activite": u'tentative de sychronisation  par mise à jour ou insertion d éléments',
                                   "Situation": 'KO', "Erreur": e.message})
            print("CompareDbModel sync_datas_tables_update_insert - Erreur lors de la synchronisation :", e.message)
            # En cas d'erreur, annuler la transaction
            try:
                conn.rollback()
                cur.close()
                conn.close()
            except Exception as e:
                print(e)
                print 'ce n est pas grave'
            return  False

    def insert_data(self, conn, table, data):
        try:
            cur = conn.cursor()

            # Récupérer la structure de la table
            cur.execute("SELECT column_name, data_type FROM information_schema.columns WHERE table_name = %s", (table,))
            columns = [row[0] for row in cur.fetchall()]

            # Vérifier que le nombre de données correspond au nombre de colonnes
            if len(data) != len(columns):
                print("tsy mitovy ny données sy colonne")
                '''raise ValueError(
                    "Le nombre de données ({}) ne correspond pas au nombre de colonnes ({}) dans la table {}".format(
                        len(data), len(columns), table))'''

            # Afficher les colonnes et les données pour déboguer
            print("Colonnes: {}".format(columns))
            print("Données à insérer: {}".format(data))

            # Construire la requête d'insertion
            columns_str = ", ".join(columns)
            placeholders = ", ".join(["%s"] * len(columns))
            insert_query = "INSERT INTO {} ({}) VALUES ({})".format(table, columns_str, placeholders)

            print("Requête d'insertion générée :")
            print("SQL : {}".format(insert_query))
            print("Valeurs : {}".format(data))

            # Adapter les données
            data = tuple(int(value) if isinstance(value, long) else value for value in data)

            # Exécuter la requête d'insertion
            cur.execute(insert_query, data)

            # Valider la transaction
            conn.commit()
            return True

        except Exception as e:
            print("Erreur lors de l'insertion: {}".format(e))
            cur.close()
            conn.rollback()
            return False
        finally:
            # S'assurer que le curseur est toujours fermé
            cur.close()

