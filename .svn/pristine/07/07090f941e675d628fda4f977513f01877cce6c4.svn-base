    def delete_data(self, conn, table, id_value):
        try:
            print('------------delete')
            cur = conn.cursor()

            # Vérifier le nom de la première colonne (ID)
            cur.execute("SELECT column_name FROM information_schema.columns WHERE table_name = %s", (table,))
            first_column = cur.fetchone()
            id_column = None

            if first_column:
                id_column = first_column[0]  # Nom de la première colonne

            if id_column is None:
                print("Error: No columns found for table {}".format(table))
                return

            # 1. Récupérer toutes les tables enfant (tables ayant une clé étrangère pointant vers cette table)
            cur.execute("""
                SELECT conname, conrelid::regclass AS table_name
                FROM pg_constraint
                WHERE confrelid = (SELECT oid FROM pg_class WHERE relname = %s)
            """, (table,))

            # Récupérer les tables enfants
            child_tables = cur.fetchall()
            print ('child_tables--------------------------------------')
            print (child_tables)

            # 2. Supprimer les données dans les tables enfant
            for child_table in child_tables:
                child_table_name = child_table[1]
                print("Deleting data from child table: {}".format(child_table_name))

                # Récupérer le nom de la colonne de la clé étrangère dans la table enfant
                '''query = """
                                SELECT column_name
                                FROM information_schema.key_column_usage
                                WHERE table_name = %s AND constraint_name IN (
                                    SELECT constraint_name
                                    FROM information_schema.table_constraints
                                    WHERE table_name = %s AND constraint_type = 'FOREIGN KEY'
                                )
                            """
                cur.execute(query, (child_table_name, table))'''



                # La requête SQL originale
                query = """
                    SELECT DISTINCT kcu.column_name, kcu.constraint_name
                        FROM information_schema.key_column_usage kcu
                        JOIN information_schema.table_constraints tc
                          ON kcu.constraint_name = tc.constraint_name
                        WHERE tc.constraint_type = 'FOREIGN KEY'
                          AND tc.table_name = '%s'
                          AND EXISTS (
                              SELECT 1
                              FROM information_schema.constraint_column_usage ccu
                              WHERE ccu.constraint_name = tc.constraint_name
                                AND ccu.table_name = '%s'
                    )
                """

                # Format de la requête avec les valeurs des variables pour Python 2.7
                formatted_query = query % (child_table_name, table)

                # Affichage de la requête formatée avant exécution
                print formatted_query
                print('*******formatted_query************')
                cur.execute(formatted_query)
                foreign_key_column = cur.fetchone()
                print('*******foreign_key_column************')
                print(foreign_key_column)
                print(child_table_name)
                print(table)
                print('*******foreign_key_ tapitra************')
                if foreign_key_column:
                    foreign_key_column_name = foreign_key_column[0]
                    print('*******foreign_key_column_name************')

                    # Vérification si des lignes existent dans la table enfant avec la clé étrangère
                    cur.execute(""" SELECT 1 FROM {} WHERE {} = %s LIMIT 1
                                    """.format(child_table_name, foreign_key_column_name), (id_value,))

                    row = cur.fetchone()
                    print('Row check result:')
                    print(row)
                    if row:
                        # Si une ligne existe, on procède à la suppression
                        cur.execute("""
                                           DELETE FROM {}
                                           WHERE {} = %s
                                       """.format(child_table_name, foreign_key_column_name), (id_value,))
                        conn.commit()
                        print("Data deleted from table: {}".format(child_table_name))
                    else:
                        # Si aucune ligne n'est trouvée, on affiche un message indiquant qu'il n'y a rien à supprimer
                        print('Nothing to delete in table: {}'.format(child_table_name))


            # 3. Supprimer l'élément de la table principale
            print("Deleting data from table: {}".format(table))
            cur.execute("""
                DELETE FROM {}
                WHERE {} = %s
            """.format(table, id_column), (id_value,))

            # Committer la transaction
            conn.commit()
            print(
            "Data deleted from table {} and related child tables where {} = {}".format(table, id_column, id_value))

        except Exception as e:
            print('Error in delete_data')
            print(str(e))  # Affichage de l'exception


    def update_data(self,conn,table,data):
        try:
            cur = conn.cursor()
            # Récupérer la structure de la table
            cur.execute("SELECT column_name, data_type FROM information_schema.columns WHERE table_name = %s",
                        (table,))
            columns = [row[0] for row in cur.fetchall()]

            # Construire la requête de mise à jour
            update_query = "UPDATE {} SET ".format(table)
            columns_to_update = columns[1:]
            data_to_update=data[1:]
            update_query += ", ".join(["{} = %s".format(column) for column in columns_to_update])

            # Conversion du tuple en liste pour pouvoir l'utiliser comme valeurs
            update_query += " WHERE {} = {}".format(columns[0], data[0]) # Condition sur la colonne de clé

            # print update_query
            cur.execute(update_query, data_to_update)
            # Valider la transaction
            conn.commit()
        except Exception as e:
            print ' error CompareDbModel update_data'
            cur.close()
            print(e.message)
            conn.rollback()

    def select_alltable_schema(self,conn):
        try:
            conn.rollback()
            # Créer un objet curseur pour exécuter des requêtes SQL
            cur = conn.cursor()
            #print'Exécuter la requête SQL pour récupérer les noms des tables du schéma spécifié'
            cur.execute("""
                SELECT table_name
                FROM information_schema.tables
                WHERE table_schema = 'public';
            """)
            #print 'Récupérer les résultats select_alltable_schema'
            res= cur.fetchall()

            return res

        except Exception as e:
            print ' error CompareDbModel select_alltable_schema'
            print(e.message)
            conn.rollback()
            return None

    def recup_table_columns(self, cur, table_name, column_name):
        try:
            # Exécution de la requête SQL

            sql_query = """
                SELECT 
                    table_name,
                    column_name,
                    CASE 
                        WHEN data_type = 'USER-DEFINED' THEN 'geometry'
                        ELSE data_type 
                    END AS data_type,
                    character_maximum_length,
                    is_nullable,
                    column_default
                FROM 
                    information_schema.columns
                WHERE 
                    table_schema = 'public'
                    AND table_name = %s
                    AND column_name = %s
            """
            # Exécution de la requête SQL avec les valeurs des paramètres
            cur.execute(sql_query, (table_name, column_name))
            # Récupération des résultats
            rows = cur.fetchall()
            print rows

            # Affichage des résultats
            return tuple(rows)

        except Exception as e:
            print 'Erreur dans recup_table_columns'
            print(e)
            cur.close()
            return None

    def update_table_columns(self, conn, schema_columns):
        # Boucle à travers les résultats et synchronisation des colonnes dans 'autre_table'
        self.current_value += 5
        self.bar.ui.progressBar.setValue(self.current_value)
        try:
            cur = conn.cursor()
            for row in schema_columns:
                row = row[0]
                table_name, column_name, data_type, character_maximum_length, is_nullable, column_default = row
                # Vérification si la colonne existe déjà dans 'autre_table'
                cur.execute("""
                        SELECT COUNT(*) 
                        FROM information_schema.columns 
                        WHERE table_schema = 'public' 
                        AND table_name = %s
                        AND column_name = %s
                    """, (table_name, column_name,))
                count = cur.fetchone()[0]

                # Si la colonne n'existe pas, l'ajouter à 'autre_table'
                if count == 0:
                    if column_default != None:
                        '''column_defaultsplit = column_default.split("(")[1].split(")")[0]
                        column_defaultsplit = column_defaultsplit.split("::")[0]
                        # Supprimer les guillemets simples entourant le nom de la séquence
                        column_defaultsplit = column_defaultsplit.strip("'")
                        sql = "CREATE SEQUENCE  %s START WITH 1;" % column_defaultsplit
                        cur.execute(sql)'''
                        # Extraire le nom de la séquence
                        try:
                            column_defaultsplit = column_default.split("(")[1].split(")")[0]
                            column_defaultsplit = column_defaultsplit.split("::")[0]
                            # Supprimer les guillemets simples entourant le nom de la séquence
                            column_defaultsplit = column_defaultsplit.strip("'")
                        except IndexError:
                            column_defaultsplit = None  # Si le format n'est pas valide, on ignore la séquence

                        # Si un nom de séquence est trouvé, vérifier si la séquence existe
                        if column_defaultsplit:
                            # Vérifier si la séquence existe déjà
                            cur.execute("""
                                 SELECT COUNT(*) 
                                 FROM pg_class 
                                 WHERE relname = %s AND relkind = 'S'
                             """, (column_defaultsplit,))
                            seq_exists = cur.fetchone()[0]

                            if seq_exists == 0:
                                # Créer la séquence si elle n'existe pas
                                sql = "CREATE SEQUENCE %s START WITH 1;" % column_defaultsplit
                                cur.execute(sql)
                                print("Séquence %s créée." % column_defaultsplit)
                            else:
                                print("La séquence %s existe déjà." % column_defaultsplit)

                    sql_query = """
                                     CREATE TABLE IF NOT EXISTS %s();
                                            ALTER TABLE %s
                                            ADD COLUMN %s %s 
                                            %s
                                            %s
                                            %s
                                        """ % (table_name, table_name, column_name, data_type,
                                               '' if character_maximum_length is None else '(%s)' % character_maximum_length,
                                               'NOT NULL' if is_nullable == 'NO' else '',
                                               '' if column_default is None else 'DEFAULT %s' % column_default)

                    # print sql_query
                    # Exécuter la requête SQL
                    cur.execute(sql_query)
                    conn.commit()
                    self.dataTolog.append(
                        {"Connexion": 'Local', "Table": row, "Activite": u'Création ou mise à jour de la colonne',
                         "Situation": 'OK', "Erreur": ''})
            print '******************************************************ETO TOKONY MANAO LOG ***********************************************************************************'
            self.current_value += 5
            self.bar.ui.progressBar.setValue(self.current_value)
            return True
        except Exception as e:
            self.dataTolog.append({"Connexion": 'Local', "Table": schema_columns,
                                   "Activite": u'Tentative de synchronisation des tables et colonnes ',
                                   "Situation": 'KO', "Erreur": e.message})

            print ' error function update_table_columns'
            try:
                cur.close()
                conn.rollback()
            except Exception as e:
                print(e)
            print(e.message)
            return False

    def checkSequence(self,conn, table, colonne, current_value):
        try:
            cur = conn.cursor()
            sql = "SELECT pg_get_serial_sequence('" + table + "', '" + colonne + "')"
            print sql
            cur.execute(sql)
            res = cur.fetchall()
            print res
            print '///////////////'
            if res and res[0][0]:
                # Si res n'est pas vide et que le nom de la séquence existe
                exe = cur.execute("ALTER SEQUENCE " + res[0][0] + " RESTART WITH %s ", (current_value,))
                conn.commit()
                print("Séquence mise à jour.")

            else:
                # Si res est vide ou la séquence est None, on ne fait rien
                print("Aucune séquence trouvée ou la séquence est nulle.")

            self.dataTolog.append({"Connexion": 'Local', "Table": table, "Activite": u'Mise à jour de la sequence',
                    "Situation": 'OK' if res and res[0][0] else u'Pas de séquence trouvée', "Erreur": ''})

        except Exception as e:
            self.dataTolog.append(
                {"Connexion": 'Local', "Table": table, "Activite": u'Tentative de Mise à jour de la sequence ', "Situation": 'KO',
                 "Erreur": e.message})
            print ' error function checkSequence'
            try:
                cur.close()
                conn.rollback()
            except Exception as e:
                print(e)
            print(e.message)

    def get_current_sequence_value(self,conn,table_name):
        cur = conn.cursor()
        data={}
        try:
            current_value=None
            cur.execute("SELECT column_name, data_type FROM information_schema.columns WHERE table_name = %s", (table_name,))
            columns = [row[0] for row in cur.fetchall()]

            print '------------------------column_id-----------------------------------------'
            print columns[0]

            # Récupérer le nom de la séquence associée à la table
            cur.execute("SELECT pg_get_serial_sequence(%s, %s)", (table_name,columns[0]))
            sequence_name = cur.fetchone()[0]
            data['current_value']='1'
            data['columns_id']=columns[0]
            print '***********************'
            if sequence_name:
                cur.execute("SELECT nextval(%s)", (sequence_name,))
                cur.execute("SELECT currval(%s)", (sequence_name,))
                current_value = cur.fetchone()[0]
                data['current_value']=current_value

            return data

        except Exception as e:
            print ' error CompareDbModel  get_current_sequence_value '
            print(e.message)
            try:
                conn.rollback()
                cur.close()
                conn.close()
            except Exception as e:
                print(e)
                print 'ce n est pas grave'
            return data

    def get_pgdump_path(self,conn):
        setting = None
        cursor = conn.cursor()
        try:
            cursor.execute("SELECT setting FROM pg_settings where name like 'data_directory'")
            setting = cursor.fetchone()


            if setting is None:
                return None
            b = os.path.dirname(setting[0])
            type='pg_dump'
            test=str(os.path.join(b, "bin\\%s.exe" % type))
            print test
            return test

        except Exception as e:
            print(e)

