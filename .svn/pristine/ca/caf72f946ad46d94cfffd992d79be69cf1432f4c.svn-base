from usecases.ogrimporter.IDataMapper import IDataMapper
import re
import psycopg2
import psycopg2.extras
import globalvars
from Configuration import DbConfig
db_config = DbConfig.DbConfig()



class DemandeMapper(IDataMapper):
    def __init__(self):
        self.connection = psycopg2.connect(database=db_config.db_name, user=db_config.db_user,
                                       password=db_config.db_pass, host=db_config.db_host)
    def getDestinationTableName(self):
        return "demande"

    def getSourceQuery(self):
        return 'SELECT * FROM demandeCertificat'

    def map(self, row):
        return [
            {'numdemande': row['numeroDemande']},
            {'gid': self.__getGid(row)},
            {'datedemande': self.__getDateDemande(row)},
            {'nomdemandeur':row['listeDemandeurs']},
            {'datereconnaissance': self.__getDateReconnaissance(row)},
            {'region': globalvars.nomregion},
            {'district': globalvars.nomdistrict},
            {'commune': globalvars.nomcommune},
            {'cout':row['coutDemande']},
            {'idprojet': 1},
            {'idcommune':globalvars.id_commune},
            {'idfokontany': self.__getIdFokontany(row)},
            {'consistance': self.__getNomConsistance(row)},
            {'categorie': self.__getNomConsistance(row)}
        ]

    def __getGid(self,row):
        cur = self.connection.cursor()
        try:
            cur.execute('SELECT gid from parcelle_d WHERE numdemande=%s',(row['numeroDemande'],))
            res = cur.fetchone()
            return res[0]
        except Exception as err:
            print (err)
            return None

    def __getDateDemande(self,row):
        parts = re.split('T', row['dateDemande'])
        return parts[0]

    def __getDateReconnaissance(self,row):
        parts = re.split('T', row['dateReconnaissance'])
        return parts[0]

    def __getIdFokontany(self,row):
        code_fkt = str(row['fokotany']).strip()
        cur = self.connection.cursor()
        try:
            cur.execute('SELECT idfokontany from fokontany WHERE TRIM(codefokontany) = %s',(code_fkt,))
            res = cur.fetchone()
            return res[0]
        except Exception as err:
            print (err)
            return None

    def __getNomConsistance(self, row):
        cur = self.connection.cursor()
        try:
            cur.execute('SELECT libelleconsistance from consistance WHERE idconsistance = %s',(row['consistance'],))
            res = cur.fetchone()
            return res[0]
        except Exception as err:
            print (err)
            return ""