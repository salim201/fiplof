        # print result

    def getNomHameau(self, idhameau):
        # Hameaux
        try:
            self.cur.execute(
                "SELECT h.nomhameau, h.idhameau, h.idfokontany, f.nomfokontany FROM hameau h, fokontany f WHERE h.idfokontany = f.idfokontany AND h.idhameau = %s",
                (idhameau,))
            hmx = self.cur.fetchone()
            print hmx
            if hmx is not None:
                self.nomHameau = hmx[0]
            else:
                self.nomHameau = None
                QMessageBox.warning(None, u"Attention!", u"Le hameau associé à ce certificat n'existe pas ou a été supprimé!")
        except Exception as err:
            print (err)
            self.connection.rollback()
        #self.ui.comboBoxHameau.addItem(hmx[0], hmx[1])
        # Determiner le fokontany
        #self.ui.comboBoxFokontany.addItem(hmx[3], hmx[2])
    def fillHameau(self):
        self.idsHameau[:] = []
        self.ui.comboBoxHameau.clear()
        print ("FILL Hameau")
        # Hameaux
        if self.ui.comboBoxFokontany.currentIndex() != -1:
            idfokontany = self.idsFokontany[self.ui.comboBoxFokontany.currentIndex()]
            self.cur.execute("SELECT h.nomhameau, h.idhameau FROM hameau h, fokontany f WHERE h.idfokontany = f.idfokontany AND f.idfokontany = %s", (idfokontany,))
            hmx = self.cur.fetchall()
            for hm in hmx:
                self.ui.comboBoxHameau.addItem(hm[0], hm[1])
                self.idsHameau.append(hm[1])
            if self.nomHameau is not None:
                self.ui.comboBoxHameau.setCurrentIndex(self.ui.comboBoxHameau.findText(self.nomHameau))
            else:
                self.ui.comboBoxHameau.setCurrentIndex(-1)
        print "apres hameau"

    def fillFields(self, data):
        #self.clearAll()
        date = datetime.datetime.now()
        if data[0]:
            if data[0] == "Certificat foncier":
                self.ui.comboBoxTypeCert.setCurrentIndex(0)
            elif data[0] == "Attestation de reconnaissance":
                self.ui.comboBoxTypeCert.setCurrentIndex(1)
        if data[1]:
            self.ui.lineEditNumCert.setText(str(data[1]).strip())
        if data[2]:
            self.ui.comboBoxNumDemande.addItem(data[2])
        if data[3]:
            #self.ui.comboBoxConsist.addItem(data[3])
            self.currentConsistance = data[3]
        if data[4]:
            self.ui.lineEditEtat.setText(data[4])
        if data[5]:
            self.ui.dateEditReconnaissance.setDate(data[5])
        if data[6]:
            #special PLAE
            #self.ui.lineEditEdition.setText(data[6].strftime('%d/%m/%Y'))
            self.ui.lineEditEdition.setText(date.strftime('%d/%m/%Y'))
        if data[7]:
            #special PLAE
            #self.ui.dateEditDelivrance.setDate(data[7])
            self.ui.dateEditDelivrance.setDate(date)

            # Fokontany
        try:
            if data[11] != '':
                self.cur.execute(
                    "SELECT DISTINCT nomfokontany, idfokontany, codefokontany FROM fokontany WHERE idfokontany = %s",
                    (data[11],))
                fkts = self.cur.fetchone()
                self.nomFokontany = fkts[0]
        except StandardError as e:
            print e

    def fillTerritoire(self, idParcelle):
        self.idsFokontany[:] = []
        #self.ui.comboBoxFokontany.clear()
        # Recuperer le nom de la commune
        print "FILL TERRITOIRE"
        dist = None
        try:
            self.cur.execute("SELECT nomcommune, codecommune FROM commune WHERE idcommune = %s",
                             (globalvars.id_commune,))
            com = self.cur.fetchone()
            self.ui.comboBoxCommune.addItem(com[0])
        except StandardError as e:
            print e
        # Recuperer le district
        try:
            self.cur.execute(
                "SELECT d.nomdistrict, d.iddistrict, d.codedistrict FROM district d, commune c WHERE d.iddistrict = c.iddistrict AND c.idcommune = %s",
                (globalvars.id_commune,))
            dist = self.cur.fetchone()
            self.ui.comboBoxDistrict.addItem(dist[0])
        except StandardError as e:
            print e
        # Region
        try:
            self.cur.execute(
                "SELECT r.nomregion FROM region r, district d WHERE d.idregion = r.idregion AND d.iddistrict = %s",
                (dist[1],))
            reg = self.cur.fetchone()
            self.ui.comboBoxRegion.addItem(reg[0])
        except StandardError as e:
            print e

        self.fillFokontany()
            # Hameaux
            # self.cur.execute("SELECT h.nomhameau, h.idhameau FROM hameau h, fokontany f WHERE h.idfokontany = f.idfokontany AND f.idfokontany = %s", (fkt[1],))
            # hmx = self.cur.fetchall()
            # for hm in hmx:
            #    self.ui.comboBoxHameau.addItem(hm[0], hm[1])
            # print "apres hameau"
    def fillFokontany(self):
        self.ui.comboBoxFokontany.clear()
        try:
            self.cur.execute("SELECT nomfokontany, idfokontany FROM fokontany WHERE idcommune = %s",(globalvars.id_commune, ) )
            fkts = self.cur.fetchall()
            for fkt in fkts:
                print fkt
                self.ui.comboBoxFokontany.addItem(fkt[0], fkt[1])
                self.idsFokontany.append(fkt[1])

            if self.nomFokontany is not None:
                self.ui.comboBoxFokontany.setCurrentIndex(self.ui.comboBoxFokontany.findText(self.nomFokontany))
        except StandardError as e:
            print e
        print "apres fokontany"

