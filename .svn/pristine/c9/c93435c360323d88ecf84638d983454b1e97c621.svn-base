    def readInput(self):
        print "read input"
        data = {}
        data['typecertificat'] = unicode(self.ui.comboBoxTypeCert.currentText()).encode('utf-8')
        data['numcertificat'] = unicode(self.ui.lineEditNumCert.text()).encode('utf-8')
        data['numdemande'] = unicode(self.ui.comboBoxNumDemande.currentText()).encode('utf-8')
        data['consistance'] = unicode(self.ui.comboBoxConsist.currentText()).encode('utf-8')
        data['categorie'] = unicode(self.ui.lineEditEtat.text()).encode('utf-8')
        data['etat'] = unicode(self.ui.lineEditEtat.text()).encode('utf-8')
        data['datereconnaissance'] = datetime.date(self.ui.dateEditReconnaissance.date().year(), self.ui.dateEditReconnaissance.date().month(), self.ui.dateEditReconnaissance.date().day())
        data['dateregistre'] = datetime.date(self.ui.dateEditInscriptionRegistre.date().year(), self.ui.dateEditInscriptionRegistre.date().month(), self.ui.dateEditInscriptionRegistre.date().day())
        data['dateImpression'] = self.ui.lineEditEdition.text()
        data['dateDelivrance'] = datetime.date(self.ui.dateEditDelivrance.date().year(), self.ui.dateEditDelivrance.date().month(), self.ui.dateEditDelivrance.date().day())

        # FERMER LA FENETRE DES PROPRIETAIRES
        #if self.etatOpposition == 0:
        if self.ui.comboBoxHameau.currentIndex() != -1:
            self.writeData(data)
        else:
            QMessageBox.critical(None, u"Erreur!", u"Vous devez choisir un hameau avant de pouvoir enregistrer le Certificat!")
        #else:
            #QMessageBox.critical(self,"Opposition non resolue","Il y a encore des oppositions non resolues sur cette demande")

    def writeData(self, data):
        print "writeData in edition CF 2022"
        #idsCertificat = None
        #get l'id fokontany
        idfokontany = self.idsFokontany[self.ui.comboBoxFokontany.currentIndex()]

        print idfokontany
        try:
            print data['numcertificat']
