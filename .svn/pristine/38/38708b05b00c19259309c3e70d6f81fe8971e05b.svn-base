CREATE TABLE public.impot_contribuable
(
   id bigserial, 
   hetratrano money, 
   hetratany money, 
   etatpaiement smallint, 
   annee smallint, 
   datereglement date, 
   montantpaye money, 
   CONSTRAINT pk_impot_contribuable PRIMARY KEY (id)
) 
WITH (
  OIDS = FALSE
)
;
ALTER TABLE public.impot_contribuable
  OWNER TO postgres;
