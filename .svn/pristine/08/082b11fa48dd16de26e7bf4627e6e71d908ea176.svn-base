    def importTitre(self):
        title = ["TITRES","PROPRIETE","SUR_PLAN","TITRE_R","PARCELLE","PARTIE","FEUILLE","ETAT_INSERTION"]
        dataToLog = []
        self.current_step = self.current_step + 1
        self.emit(SIGNAL("clearSubstep(int)"), self.current_step)

        layer = QgsVectorLayer(_fromUtf8(str(self.filename)), "dataFromPLOFPapers", "ogr")
        features = layer.getFeatures()
        countFeatures = layer.featureCount()
        self.emit(SIGNAL("clearSubstep(int)"), self.current_step)
        try:
            provider = layer.dataProvider()
            fields = provider.fields()
            titres_req = 0
            propriete = 0
            sur_plan = 0
            titre_r = 0
            partie = 0
            feuille = 0
            parcelle = 0
            counter = 0
            verifColonne = 0

            for field in fields:
                header = str(field.name()).lower()

                if header == "titres":
                    titres_req = counter
                    counter = counter + 1 
                    verifColonne = verifColonne + 1 
                
                elif header == "propriete":
                    propriete = counter
                    counter = counter + 1 
                    verifColonne = verifColonne + 1
                
                elif header == "sur_plan":
                    sur_plan = counter
                    counter = counter + 1 
                    verifColonne = verifColonne + 1
                
                elif header == "titre_r":
                    titre_r = counter
                    counter = counter + 1 
                    verifColonne = verifColonne + 1
                
                elif header == "partie":
                    partie = counter
                    counter = counter + 1 
                    verifColonne = verifColonne + 1
                
                elif header == "feuille":
                    feuille = counter
                    counter = counter + 1 
                    verifColonne = verifColonne + 1
                
                elif header == "parcelle":
                    parcelle = counter
                    counter = counter + 1 
                    verifColonne = verifColonne + 1
                else:
                    counter = counter + 1

            if verifColonne >= 7:
                i = 0
                for f in features:
                    try:
                        geometry = f.geometry()
                        if geometry.wkbType() == QGis.WKBPolygon:
                            x = geometry.asPolygon()
                        if geometry.wkbType() == QGis.WKBMultiPolygon:
                            x = geometry.asMultiPolygon()[0]
                        attrs = f.attributes()

                        name_titre = str(attrs[titres_req].toPyObject())
                        name_Propriete = str(attrs[propriete].toPyObject())
                        name_sur_plan = str(attrs[sur_plan].toPyObject())
                        name_titre_R = str(attrs[titre_r].toPyObject())
                        name_parcelle = str(attrs[parcelle].toPyObject())
                        name_partie = str(attrs[partie].toPyObject())
                        name_feuille = str(attrs[feuille].toPyObject())


                        if name_sur_plan == "":
                            name_sur_plan = None
                        else:
                            name_sur_plan = float(name_sur_plan)
                        
                        if name_titre == "":
                            name_titre = None

                        if name_titre_R == "":
                            name_titre_R = None

                        if name_Propriete == "":
                            name_Propriete = None

                        if name_parcelle == "":
                            name_parcelle = None

                        if name_partie == "":
                            name_partie = None

                        if name_feuille == "":
                            name_feuille = None

                        if len(self.checkGeomEquality(str(geometry.exportToWkt()),"titre")) == 0:
                            try:
                                cursor = self.connection.cursor()
                                exe = cursor.execute(
                                        "INSERT INTO titre (titres,propriete,sur_plan,titre_r,parcelle,partie,feuille,geom) VALUES ("
                                            "%s,%s,%s,%s,%s,%s,%s,ST_GeomFromText(%s, "+str(globalvars.EPSG_SCR) + "))",
                                        (name_titre,name_Propriete,name_sur_plan, name_titre_R,name_parcelle,name_partie,name_feuille,str(geometry.exportToWkt()),))
                                    
                                self.connection.commit()
                                cursor.close()
                                self.emit(SIGNAL("addSubStep(int, QString, QString)"), self.current_step,
                                    u"Parcelle %s insérée dans la base" % (str(name_titre)), "green")
                                etat_insertion = "INSERTION  REUSSIE"
                            except Exception as err:
                                print(err)
                                self.connection.rollback()
                        else:
                            self.emit(SIGNAL("addSubStep(int, QString, QString)"), self.current_step,
                              u"Parcelle %s existe déjà dans la base de données" % name_titre , "red")  
                            etat_insertion = "PARCELLE EN DOUBLON"
                    except Exception as e:
                        print("-----------------Erreur-------------")
                        print(e)
                    p = (i + 1) * 100 / countFeatures
                    self.emit(SIGNAL("progress(int)"), p)
                    i = i + 1
                    dataToLog.append({"TITRES": name_titre,"PROPRIETE": name_Propriete,"SUR_PLAN": name_sur_plan,"TITRE_R": name_titre_R,
                                      "PARCELLE": name_parcelle,"PARTIE": name_partie,"FEUILLE": name_feuille,
                                      "ETAT_INSERTION": etat_insertion})
                try:
                    self.logger.addSheetShapePLOF(title=title, data = dataToLog, sheet_name="Log_Import_Shape_Titre ")
                except Exception as e:
                    print("-----------------Erreur-------------")
                    print(e)
            else:
                self.emit(SIGNAL("alert(QString)"), "Veuillez bien respecter la nomenclature des tables attributaires Titre")
        except Exception as e:
            print("-----------------Erreur-------------")
            print(e)    
    




