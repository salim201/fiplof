                              u"Parcelle %s existe déjà dans la base de données" % name_parcelle , "red")
                            etat_insertion = "PARCELLE EN DOUBLON"
                    except Exception as e:
                        print(' parcelle ayant des probleme de geometrie')
                    p = (i + 1) * 100 / countFeatures
                    self.emit(SIGNAL("progress(int)"), p)
                    i = i + 1
                    dataToLog.append({"NOM_SECTION": name_nom_section,"SECTION": name_section,"PARCELLE": name_parcelle,"NOM_PLAN": name_nom_plan,
                                      "ETAT_INSERTION": etat_insertion})
                try:
                    self.logger.addSheetShapePLOF(title=title, data = dataToLog, sheet_name="Log_Import_Shape_Cadastre")
                except Exception as e:
                    print("-----------------Erreur-------------")
                    print(e)
            else:
                self.emit(SIGNAL("alert(QString)"), "Veuillez bien respecter la nomenclature des tables attributaires Cadastre")      
        except Exception as e:
