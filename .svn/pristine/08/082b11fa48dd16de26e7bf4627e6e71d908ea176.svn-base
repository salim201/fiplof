from PyQt4 import QtCore, QtGui
from logs import xlsLogger

try:
    _fromUtf8 = QtCore.QString.fromUtf8
except AttributeError:
    _fromUtf8 = lambda s: s

try:
    _encoding = QtGui.QApplication.UnicodeUTF8
    def _translate(context, text, disambig):
        return QtGui.QApplication.translate(context, text, disambig, _encoding)
except AttributeError:
    def _translate(context, text, disambig):
        return QtGui.QApplication.translate(context, text, disambig)


class ImportShapePLOFThread(QThread):
    def __init__(self, filename, connection,comboListecouche):
        QThread.__init__(self)
        self.filename, self.connection,self.comboListecouche = filename, connection, comboListecouche
        self.current_step =-1
        self.logger = xlsLogger.xlsLogger("Import_Shapefile")

    def __del__(self):
        self.wait()

    def run(self):
        if self.filename == "":
            self.emit(SIGNAL("alert(QString)"), "Veuillez choisir un fichier")
            return
    
        self.current_step = -1

        #IMPORT PARCELLE
        self.emit(SIGNAL("stepInit(int)"), self.current_step + 1)

        if self.comboListecouche == "Titre":
            self.importTitre()

        if self.comboListecouche == "Cadastre":
            self.importCadastre()

        if self.comboListecouche == "Demande FN":
            self.importDemandeFn()

        if self.comboListecouche == "TSS":
            self.importTerrain_Status_Specifique()

        self.emit(SIGNAL("stepDone(int)"), self.current_step)
        self.logger.write()

    def checkGeomEquality(self, str_geom,couche):
        try:
            cur = self.connection.cursor()
            sql = "SELECT geom FROM " + couche + " WHERE ST_OrderingEquals(ST_GeomFromText(%s,"+str(globalvars.EPSG_SCR)+"), geom)"
            cur.execute(sql, (str_geom,))
            res = cur.fetchall()
            cur.close()
            return res
        except Exception as err:
            print(err)
            self.connection.rollback()
            return None

    def importTerrain_Status_Specifique(self):
        title = ["FN_FG","DEMANDEUR","SUR_PLAN","OBSERVATION","ETAT_INSERTION"]
        dataToLog = []
        self.current_step = self.current_step + 1
        self.emit(SIGNAL("clearSubstep(int)"), self.current_step)

        layer = QgsVectorLayer(_fromUtf8(str(self.filename)), "dataFromPLOFPapers", "ogr")
        features = layer.getFeatures()
        countFeatures = layer.featureCount()
        self.emit(SIGNAL("clearSubstep(int)"), self.current_step)
        try:
            provider = layer.dataProvider()
            fields = provider.fields()
            fn_fg,demandeur,sur_plan,obs = 0,0,0,0 
            counter = 0
            verifcolonne = 0

            for field in fields:
                header = str(field.name()).lower()
            
                if header == "fn_fg":
                    fn_fg = counter
                    counter = counter + 1 
                    verifcolonne = verifcolonne + 1 
                
                elif header == "demandeur":
                    demandeur = counter
                    counter = counter + 1
                    verifcolonne = verifcolonne + 1 
                
                elif header == "sur_plan":
                    sur_plan = counter
                    counter = counter + 1
                    verifcolonne = verifcolonne + 1 
                
                elif header == "obs":
                    obs = counter
                    counter = counter + 1
                    verifcolonne = verifcolonne + 1 
                else:
                    counter = counter + 1
      
            if verifcolonne >= 4:
                i = 0
                for f in features:
                    try:
                        geometry = f.geometry()
                        if geometry.wkbType() == QGis.WKBPolygon:
                            x = geometry.asPolygon()
                        if geometry.wkbType() == QGis.WKBMultiPolygon:
                            x = geometry.asMultiPolygon()[0]
                        attrs = f.attributes()

                        name_fn_fg = str(attrs[fn_fg].toPyObject())
                        name_demandeur = str(attrs[demandeur].toPyObject())
                        name_sur_plan = str(attrs[sur_plan].toPyObject())
                        name_obs = str(attrs[obs].toPyObject())

                        if name_fn_fg == "":
                            name_fn_fg = None
                        
                        if name_demandeur == "":
                            name_demandeur = None

                        if name_sur_plan == "":
                            name_sur_plan = None
                        else:
                            name_sur_plan = float(name_sur_plan)
                        
                        if name_obs == "":
                            name_obs = None

                        if len(self.checkGeomEquality(str(geometry.exportToWkt()),"terain_status_specifique")) == 0:
                            try:
                                cursor = self.connection.cursor()
                                exe = cursor.execute(
                                        "INSERT INTO terain_status_specifique (fn_fg,demandeur,sur_plan,obs,geom) VALUES ("
                                            "%s,%s,%s,%s,ST_GeomFromText(%s, "+str(globalvars.EPSG_SCR) + "))",
                                        (name_fn_fg,name_demandeur,name_sur_plan,name_obs,str(geometry.exportToWkt()),))
                                    
                                self.connection.commit()
                                cursor.close()
                                self.emit(SIGNAL("addSubStep(int, QString, QString)"), self.current_step,
                                u"Parcelle %s insérée dans la base de données" % (str(name_fn_fg)), "green")
                                etat_insertion = "INSERTION  REUSSIE"
                            except Exception as err:
                                print(err)
                                self.connection.rollback()
                        else:
                            self.emit(SIGNAL("addSubStep(int, QString, QString)"), self.current_step,
                              u"Parcelle %s existe déjà dans la base de données" % name_fn_fg , "red")
                            etat_insertion = "PARCELLE EN DOUBLON"
                    except Exception as e:
                        print(' parcelle ayant des probleme de geometrie')
                    p = (i + 1) * 100 / countFeatures
                    self.emit(SIGNAL("progress(int)"), p)
                    i = i + 1
                    dataToLog.append({"FN_FG": name_fn_fg,"DEMANDEUR": name_demandeur,"SUR_PLAN": name_sur_plan,"OBSERVATION": name_obs,
                                      "ETAT_INSERTION": etat_insertion})
                try:
                    self.logger.addSheetShapePLOF(title=title, data = dataToLog, sheet_name="Log_Import_Shape_TSS")
                except Exception as e:
                    print("-----------------Erreur-------------")
                    print(e)
            else:
                self.emit(SIGNAL("alert(QString)"), u"Veuillez bien respecter la nomenclature des tables attributaires Terrain Status Spécifique")      
        except Exception as e:
            print("-----------------Erreur-------------")
            print(e) 

    def importCadastre(self):
