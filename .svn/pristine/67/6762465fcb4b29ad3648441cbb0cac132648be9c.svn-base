      result = Hameau.exec_()

  def checkIfGidExist(self):
      val = False
      try:
          cur = self.connection.cursor()
          cur.execute("SELECT gid from parcelle_d WHERE gid = %s", (str(self.idparcelle),))
          res = cur.fetchone()
          if res is not None:
              if len(res) > 0:
                  val = True
                  print ("*************geometrie existe**************")
      except Exception as err:
          print (err)

      return val




