  def loadForm(self):

    self.currentIndex = int(self.ui.tabWidgetOppositionDemande.currentIndex())
    if self.currentIndex == 0:
        result = self.p.exec_()
    if self.currentIndex == 1:
        from VoisinsRun import VoisinsRun
        numDemande1 = str(self.ui.numeroDemandeLineEdit1.text())
        numdemande2 = str(self.ui.numeroDemandeLineEdit2.text())
        numDmd = numDemande1.strip() + "-F-" + numdemande2.strip()
        #numDmd = str(self.ui.numeroDemandeLineEdit.text())
        self.numDemande = numDmd

        opp = VoisinsRun(self)
        opp.show()
        result = opp.exec_()

