  def CancelData(self):
      print(" cancel geometry")
      #self.idparcelle
      if not self.fromPopup:
          try:
              self.cursor.execute("delete from parcelle_d WHERE gid=%s", [int(self.idparcelle)])
          except psycopg2.Error as e:
              self.connection.rollback()
          self.connection.commit()

      mc = self.parent.MainWindow.canvas
      #mc.unsetMapTool(self.tool_select_geometry)
      #cLayer.triggerRepaint()
      for layer in mc.layers():
          if layer.type() == layer.VectorLayer:
              layer.removeSelection()
      mc.refresh()

      for layer in mc.layers():
          layer.triggerRepaint()
      mc.refresh()
      self.close()

