# coding: utf8
import sys
import os
import os.path
from PyQt4 import QtCore, QtGui
import qgis
from qgis.core import *
from PyQt4.QtCore import SIGNAL
from Utils import Utils
from FormImportDxf import Ui_Dialog
import globalvars
from ImportDxfThread import ImportDxfThread


class ImportDXF(QtGui.QDialog):
  def __init__(self, connection):
    QtGui.QDialog.__init__(self)
    print("init constructeur")
    sys.setdefaultencoding('utf8')
    self.ui = Ui_Dialog()
    self.ui.setupUi(self)
    self.connection = connection
    self.setWindowTitle("Import de fichier DXF")
    self.ui.progressBar.setValue(0)
    self.filename= ""
    self.initActions()

  def initActions(self):
    self.ui.pushButtonFermer.clicked.connect(self.close)
    self.ui.toolButtonParcourir.clicked.connect(self.browseFile)
    self.ui.pushButtonImporter.clicked.connect(self.launch)

  def launch(self):
    self.ui.progressBar.setValue(0)
    print('launching')
    id_projet = int(globalvars.id_projet)
    if self.filename == "":
      return
    self.ui.pushButtonImporter.setEnabled(False)
    self.ui.pushButtonFermer.setEnabled(False)
    self.ui.toolButtonParcourir.setEnabled(False)
    table = None
    if str(self.ui.comboBoxCouche.currentText()).strip().lower() == 'titre':
        table = 'titre'
    if str(self.ui.comboBoxCouche.currentText()).strip().lower() == 'cadastre':
        table = 'cadastre'
    if str(self.ui.comboBoxCouche.currentText()).strip().lower() == 'demande fn':
        table = 'demandefn'
    if str(self.ui.comboBoxCouche.currentText()).strip().lower() == u'terrain à statut spécifique':
        table = 'tss'

    try:
        self.myThread = ImportDxfThread(filename=self.filename, connection=self.connection, table=table)
    except Exception as err:
        print(err)
    self.connect(self.myThread, SIGNAL("finished()"), self.termine)
    self.connect(self.myThread, SIGNAL("alert(QString)"), self.alert)
    self.connect(self.myThread, SIGNAL("progress(int)"), self.progress)
    try:
        self.myThread.start()
    except Exception as err:
        print(err)

  def browseFile(self):
    self.filename = QtGui.QFileDialog.getOpenFileName(self, "Choisissez un fichier","","Fichier de forme au format DXF(*.dxf)")
    self.ui.lineEditPath.setText(self.filename)
    self.ui.pushButtonImporter.setEnabled(True)

  def alert(self, msg):
      Utils.alert(msg)

  def progress(self, p):
      self.ui.progressBar.setValue(p)

  def termine(self):
      Utils.alert("Importation Terminee")
      self.ui.pushButtonImporter.setEnabled(True)
      self.ui.pushButtonFermer.setEnabled(True)
      self.ui.toolButtonParcourir.setEnabled(True)