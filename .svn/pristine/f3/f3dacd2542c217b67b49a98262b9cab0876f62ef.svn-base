from GeometryLoader.GeometryDataSource import GeometryDataSource
from GeometryLoader.LayerProperties import LayerProperties
import LayerStyles


class PlofLayersCollection:
    PlofStandardLayers = []  # type: list[LayerProperties]

    def __init__(self, communeId, namePrefix="", idCF = None, isCfUnique = False):
        if self.PlofStandardLayers:
            del self.PlofStandardLayers[:]
        CONDITION_COMMUNE = "idcommune=%s or idcommune is null" % communeId
        
        if idCF is None:
            CONDITION_CF = CONDITION_COMMUNE
        else:
            if isCfUnique:
                CONDITION_CF = "idcertificat IS NOT NULL"
            else:
                CONDITION_CF = "idcertificat != %s" % idCF

        layerDemand = LayerProperties(0, "Demandes Parcelle", namePrefix)
        layerDemand.styles = LayerStyles.demandStyles
        layerDemand.dataSource = GeometryDataSource("vw_demande", "numdemande", CONDITION_COMMUNE)
        layerDemand.setCurrent()
        self.PlofStandardLayers.append(layerDemand)

        # layerCertificate_singleton = LayerProperties(1, "Certificat", namePrefix)
        # layerCertificate_singleton.styles = LayerStyles.certificateStyles
        # layerCertificate_singleton.dataSource = GeometryDataSource("vw_certificat", "numerocertificat")
        # self.PlofStandardLayers.append(layerCertificate_singleton)

        layerCertificate = LayerProperties(1, "Certificats", namePrefix)
        layerCertificate.styles = LayerStyles.certificateStyles
        layerCertificate.dataSource = GeometryDataSource("vw_certificat", "numerocertificat", CONDITION_CF)
        self.PlofStandardLayers.append(layerCertificate)
        

        layerFiscalite = LayerProperties(2, "Fiscalite", namePrefix)
        layerFiscalite.styles = LayerStyles.fiscaliteStyles
        layerFiscalite.dataSource = GeometryDataSource("vw_fiscalite", "numero")
        self.PlofStandardLayers.append(layerFiscalite)

        """layerTitreFoncier = LayerProperties(3, "Proposition de titre", namePrefix)
        layerTitreFoncier.styles = LayerStyles.titreFoncierStyles
        layerTitreFoncier.dataSource = GeometryDataSource("titrefoncier", "numerotitre")
        self.PlofStandardLayers.append(layerTitreFoncier)

        layerAireSpecifique = LayerProperties(4, "Proposition d'aire a statut specifique", namePrefix)
        layerAireSpecifique.styles = LayerStyles.aireSpecifiqueStyles
        layerAireSpecifique.dataSource = GeometryDataSource('aireastatutspecifique', 'nom')
        self.PlofStandardLayers.append(layerAireSpecifique)

        layerDomainePublique = LayerProperties(5, "Proposition de domaine publique", namePrefix)
        layerDomainePublique.styles = LayerStyles.domainePubliqueStyles
        layerDomainePublique.dataSource = GeometryDataSource('domainepublique', 'nom')
        self.PlofStandardLayers.append(layerDomainePublique)
        """

        layerTitre = LayerProperties(6, "Titre", namePrefix)
        layerTitre.styles = LayerStyles.titreStyles
        layerTitre.dataSource = GeometryDataSource('vw_titre', 'titres')
        self.PlofStandardLayers.append(layerTitre)

        layerCadastre = LayerProperties(7, "Cadastre", namePrefix)
        layerCadastre.styles = LayerStyles.cadastreStyles
        layerCadastre.dataSource = GeometryDataSource('vw_cadastre', 'parcelle')
        self.PlofStandardLayers.append(layerCadastre)

        layerDemandeFn = LayerProperties(8, "Demande FN", namePrefix)
        layerDemandeFn.styles = LayerStyles.demandefnStyles
        layerDemandeFn.dataSource = GeometryDataSource('vw_demandefn', 'fn_fg')
        self.PlofStandardLayers.append(layerDemandeFn)

        layerTss = LayerProperties(9, "TSS", namePrefix)
        layerTss.styles = LayerStyles.tssStyles
        layerTss.dataSource = GeometryDataSource('vw_tss', 'fn_fg')
        self.PlofStandardLayers.append(layerTss)

    def getStandardLayers(self):
        return self.PlofStandardLayers
