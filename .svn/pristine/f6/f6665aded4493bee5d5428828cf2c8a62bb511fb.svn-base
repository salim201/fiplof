  def loadDemandeur(self,connexion):
      cursor = connexion.cursor()
      dm  = None
      try:
          cursor.execute("SELECT d.*, avd.representant as representant from personne  as d "
                         " INNER JOIN avoir_demande as avd on d.idpersonne = avd.idpersonne "
                         " where  avd.idparcelle =%s", [int(self.gid)])
          dm = cursor.fetchall()
      except Exception as err:
          print err
          connexion.rollback()

      print " load demandeurs IN "
      print dm
      self.demandeurs = []
      try :
          if (len(dm) >= 1 ):
              demandeTmp = []
              idx = 0
              for d in dm :
                  if d[4] != None :
                      dateNaissance = d[4].strftime('%d/%m/%Y')
