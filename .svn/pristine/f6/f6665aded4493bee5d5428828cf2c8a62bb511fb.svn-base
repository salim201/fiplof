  def checkOppositions(self):
      cursor = self.connection.cursor()
      cursor.execute("SELECT *   FROM oppositions  WHERE gid=%s and etatopposition = 0", [int(self.gid)])
      dm = cursor.fetchone()
      print "details checkOppositions"
      print dm
      return  dm
  def ChargerVoisins(self):
      cursor = self.connection.cursor()
      cursor.execute("SELECT l.idpointscardinaux,l.description,pc.position FROM  limitesparcelle AS l "
                     "INNER JOIN  pointscardinaux as pc"
                     " ON  pc.idpointscardinaux= l.idpointscardinaux WHERE l.idparcelle=%s", [int(self.gid)])
      dm = cursor.fetchall()
      print "LES VOISINS"
      print dm
      try:
          print("Charger Voisin")
          if (len(dm) >= 1 ):
              for d in dm :
                  data = (str(d[2]), str(d[1]), int(d[0]))
                  print("DATA PAR LIGNE")
                  print(data)
                  self.addVoisin(data)
      except Exception as e:
          print(e)


  def chargercategorie(self):

      sql = "SELECT idconsistance,libelleconsistance FROM consistance"
      self.utils.fillComboWithSql(self.ui.consistanceComboBox, sql, "libelleconsistance", "idconsistance")

  def addVoisin(self,data):
      columns = len(data)
      rowPosition = self.ui.tableVoisins.rowCount()
      self.ui.tableVoisins.setColumnCount(columns)
      self.ui.tableVoisins.insertRow(rowPosition)
      i = 0
      try :
          for i in range(len(data)):
              item = QtGui.QTableWidgetItem()
              item.setText(_translate("", str(data[i]), None))
              self.ui.tableVoisins.setItem(rowPosition, i, item)
      except StandardError as e:
          print e

  def initActions(self):

    import globalvars
    idcommune = globalvars.id_commune
    print "----------------globalvars.id_commune----------------"
    print globalvars.id_commune
    print "--------------------globalvars.id_commune-----------"
    cursor = self.connection.cursor()
    cursor.execute("SELECT *   FROM commune  WHERE idcommune=%s", [int(idcommune)])
    dm = cursor.fetchone()
    try:

        if (len(dm) >= 1):
          iddistrict = dm[1]
          cursor.execute("SELECT *   FROM district  WHERE iddistrict=%s", [int(iddistrict)])
          dm = cursor.fetchone()
          idregion = dm[1]

        cursor.execute("SELECT nomregion  FROM region  WHERE idregion=%s", [int(idregion)])
        dm = cursor.fetchone()
        if (len(dm) >= 1):
          region = dm[0]

        cursor.execute("SELECT *  FROM district  WHERE iddistrict=%s", [int(iddistrict)])
        dm = cursor.fetchone()
        if (len(dm) >= 1):
          coddistrict = dm[2]
          self.coddistrict = coddistrict

        cursor.execute("SELECT *  FROM commune  WHERE idcommune=%s", [int(idcommune)])
        dm = cursor.fetchone()
        if (len(dm) >= 1):
          codeCommune = dm[2]
          self.codecommune = codeCommune
    except Exception as e:
        print(e)

