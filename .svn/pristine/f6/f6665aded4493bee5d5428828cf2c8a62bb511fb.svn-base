                  print "representant = "
                  print d[len(d) - 1]
                  self.ui.comboBoxPrincipale.addItem(d[1] + " " + d[2],d[0])
                  if d[len(d) - 1] == True:
                      self.ui.comboBoxPrincipale.setCurrentIndex(idx)
                  data = (str(d[1]), str(d[2]),dateNaissance,str(d[7]),str(d[3]),int(d[0]))
