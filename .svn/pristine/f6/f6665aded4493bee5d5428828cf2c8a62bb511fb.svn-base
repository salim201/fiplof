      cursor.execute("SELECT *   FROM fokontany  WHERE idfokontany=%s",
                     [int(self.utils.getComboValue(self.ui.fokontanyComboBox))])
      dm = cursor.fetchone()
      print " dm FOKONTANY IN"
      print dm
      print " dm FOKONTANY OUT"

      chFkt = str(dm[2]).strip()
