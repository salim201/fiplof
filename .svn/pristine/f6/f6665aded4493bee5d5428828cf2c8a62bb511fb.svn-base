      #areaOfInterest = QgsRectangle(450290, 400520, 450750, 400780)
      areaOfInterest = QgsRectangle(700606.115262, 974857.082938, 700701.524203, 974937.192317)
      #('extent:', 700606.115262, 974857.082938, 700701.524203, 974937.192317)
      request = QgsFeatureRequest().setFilterRect(areaOfInterest)


      sql = "select * from parcelle_d "
      #uri.setDataSource("public", "parcelle_d", "geom")
      #uri.setKeyColumn("gid")
      #uri.setDataSource("public",sql, "geom")
      #uri.setDataSource('public',sql, 'geom')
      #uri.setSql("select * from parcelle_d")
      #uri.setDataSource("", "parcelle_d", "geom")
      layer = QgsVectorLayer(uri.uri(), "Demande", "postgres")
      e = layer.extent()
      print("extent:", e.xMinimum(), e.yMinimum(), e.xMaximum(), e.yMaximum())
      for feature in layer.getFeatures(request):
          # do whatever you need with the feature
          print('ID  INTERSECT')
          print(feature.id())

          pass
      if not layer.isValid():
          print("NOT A LAYER")
          return
      crs = QgsCoordinateReferenceSystem(globalvars.EPSG_SCR, QgsCoordinateReferenceSystem.EpsgCrsId)
      layer.setCrs(crs)
      symbol_layer = QgsFillSymbolV2.createSimple(style)
      layer.rendererV2().setSymbol(symbol_layer)
      QgsMapLayerRegistry.instance().addMapLayer(layer)
      QgsMapLayerRegistry.instance().addMapLayer(self.layer_raster)
      self.cvs.setLayerSet([QgsMapCanvasLayer(layer),QgsMapCanvasLayer(self.layer_raster)])
      self.cvs.setExtent(layer.extent())
