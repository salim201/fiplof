          self.ui.checkBoxDateDecision.setChecked(True)
          self.ui.checkBoxDateReconnaissance.setChecked(True)
          self.ui.checkBoxNumDecision.setChecked(True)
          self.ui.checkBoxDebutAffichage.setChecked(True)
          self.ui.checkBoxFinAffichage.setChecked(True)
      else:
          self.ui.checkBoxDateDecision.setChecked(False)
