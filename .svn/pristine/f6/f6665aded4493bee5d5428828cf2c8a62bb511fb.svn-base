  def addValueTable(self, data):
      columns = len(data)
      self.isIn = 0
      print "add data in"
      rowPosition = self.ui.tableDemande.rowCount()
      i = 0
      if rowPosition >= 1 :
          while (i < rowPosition ) :
              j = 0
              idD = self.ui.tableDemande.item(i,5).text()
              if int(idD) == int(data[5]):
                  self.isIn = 1
                  break
              i = i + 1

      if self.isIn == 1:
          QMessageBox.critical(self.ui.tableDemande, "Erreur", "Demandeur deja enregistrE")
          return
      else :
          self.ui.tableDemande.setColumnCount(columns)
          self.ui.tableDemande.insertRow(rowPosition)
          self.isIn = 0
          self.ui.comboBoxPrincipale.addItem(data[0] + data[1], data[5])
          for i in range(len(data)):
