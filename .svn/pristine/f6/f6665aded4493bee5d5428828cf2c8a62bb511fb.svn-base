  def updateDemandeurs(self):

      if self.idDemandeurS == 0 :
          QMessageBox.critical(self.ui.tableDemande, "Erreur",
                               "Veuillez selectionner un demandeur")
          return
      else :

          from DemandeursUpdateFormRun import DemandeursUpdateFormRun
          #numDmd = str(self.ui.numeroDemandeLineEdit.text())

          numDemande1 = str(self.ui.numeroDemandeLineEdit1.text())
          numdemande2 = str(self.ui.numeroDemandeLineEdit2.text())
          numDmd = numDemande1.strip() + "-F-" + numdemande2.strip()
          self.numDemande = numDmd
          demandeurs = DemandeursUpdateFormRun(self)
          demandeurs.show()
          result = demandeurs.exec_()

  def RegForm(self):
      if self.idopposition != 0:
          from ReglementFormRun import Reglement
          # detail = DetailsDemandeRunn(self)
          rg = Reglement(self)
          rg.show()
          result = rg.exec_()

  def FetchDemandeCF(self):
    cursor = self.connection.cursor()
    cursor = self.connection.cursor()
    import globalvars

    print " FetchDemandeCF in "
    print self.gid
    print " FetchDemandeCF out"
    try :
        cursor.execute("SELECT *   FROM parcelle_d  WHERE gid=%s", [self.gid])
        grille = cursor.fetchone()

        cursor.execute("SELECT *   FROM demande  WHERE gid=%s", [self.gid])
        res = cursor.fetchone()

        cursor.execute("SELECT *   FROM commune  WHERE idcommune=%s", [int(globalvars.id_commune)])
        commune = cursor.fetchone()
    except StandardError as e:
      print e

    try :

        if (len(res) >= 1):
          dateDemande = None
          try:
              dateDemande = res[9].isoformat()
              year, month, day = res[9].isoformat().split("-")
              dateDemande = date(int(year), int(month), int(day))
              self.ui.dateDemandeDateEdit.setDate(dateDemande)
          except Exception as err:
              print (err)


          dateReconnaissance = None
          try:
              dateReconnaissance = res[10].isoformat()
              year, month, day = res[10].isoformat().split("-")
              dateReconnaissance = date(int(year), int(month), int(day))
              self.ui.dateReconnaissanceDateEdit.setDate(dateReconnaissance)
              self.ui.checkBoxDateReconnaissance.setChecked(True)
          except Exception as err:
              self.ui.checkBoxDateReconnaissance.setChecked(False)
              print (err)

          dateDecision = None
          if res[23] != None :
              print ('date decision*********************************')
              print(res[23])
              dateDecision = res[23].isoformat()
              year, month, day = res[23].isoformat().split("-")
              dateDecision = date(int(year), int(month), int(day))
              self.ui.checkBoxDateDecision.setChecked(True)
              self.ui.dateDecision.setDate(dateDecision)
          else:
              self.ui.checkBoxDateDecision.setChecked(False)

          dateDebAff = None
          if res[31] != None:
              dateDebAff = res[31].isoformat()
              year, month, day = res[31].isoformat().split("-")
              dateDebAff = date(int(year), int(month), int(day))
              self.ui.checkBoxDebutAffichage.setChecked(True)
              self.ui.dateEditDebutAffichage.setDate(dateDebAff)
          else:
              self.ui.checkBoxDebutAffichage.setChecked(False)

          dateFinAff = None
          if res[32] != None:
              dateFinAff = res[32].isoformat()
              year, month, day = res[32].isoformat().split("-")
              dateFinAff = date(int(year), int(month), int(day))
              self.ui.checkBoxFinAffichage.setChecked(True)
              self.ui.dateEditFinAffichage.setDate(dateFinAff)
          else:
              self.ui.checkBoxFinAffichage.setChecked(False)

          try:
              if res[28] != None:
                  self.ui.numeroGrilleLineEdit.setText(str(res[28]))
          except Exception:
              pass
          try:
              if res[41] != None:
                  self.ui.lineEditDureeMiseEnValeur.setText(str(res[41]))
          except Exception:
              pass
          try:
              if res[42] != None:
                  self.ui.textEditOrigine.setText(str(res[42]))
          except Exception:
              pass


          self.iddemandeForJournal = res[0]  # Recuperation de l'id de la table demande
          print "res[2]"
          print str(res[2])
          self.currentNumDemande = str(res[2]).strip()
          Demande = str(res[2]).split('-F-')
          self.ui.numeroDemandeLineEdit1.setText(str(Demande[0]))
          self.ui.numeroDemandeLineEdit2.setText(str(Demande[1]))
          if res[30] is not None:
              self.ui.checkBoxNumDecision.setChecked(True)
              self.ui.lineEditNumDecision.setText(str(res[30]))
          else:
              self.ui.checkBoxNumDecision.setChecked(False)
          self.iddemande = int(res[0])
          if res[19] is not None:
              self.ui.coutLineEdit.setText(str(res[19]))
          else:
              self.ui.coutLineEdit.setText('0')
          self.ui.regionLineEdit.setText(str(res[11]))
          self.ui.districtLineEdit.setText(str(res[12]))
          self.ui.communeLineEdit.setText(str(commune[3]))
          if res[22] is not None:
            self.ui.numdmdsurplof.setText(str(res[22]))

          if res[25] is not None:
              self.ui.lineEditCodeParcelle.setText(str(res[25]).strip())
          else:
              self.ui.lineEditCodeParcelle.setText('')
          try :
              cursor = self.connection.cursor()
              cursor.execute("SELECT *   FROM consistance  WHERE libelleconsistance=%s", [str(res[26])])
              dm = cursor.fetchone()
              self.utils.setComboValue(self.ui.consistanceComboBox, int(dm[0]))
          except StandardError as e:
              print "erreur consistance"
              print e

          print "Consistance"
          if res[26] != None:
              self.ui.consistanceComboBox.setCurrentIndex(self.ui.consistanceComboBox.findText(res[26]))
          else:
              self.ui.consistanceComboBox.setCurrentIndex(-1)

          #Utils.setComboValue(self.ui.consistanceComboBox, str(res[24]))
          #self.ui.consistanceComboBox((Utils.setComboValue(self.area)))
          self.ui.lineEditConsistances.setText(str(res[20]))
          #self.ui.numeroGrilleLineEdit.setText(str(grille[30]))

          #self.ui.numeroDemandeSurPLOFPapierLineEdit.setText(str(res[22]))

          self.idFkt   = int(res[16])
          self.loadFokontany(int(commune[0]),self.idFkt)
          self.idHam = int(grille[20])
          self.loadHameau(self.idHam)
          self.ui.fokontanyComboBox.currentIndexChanged.connect(self.loadHameau)
          #self.loadConsistance(self.connection)
          self.loadOpposition(self.connection)
          self.loadDemandeur(self.connection)
          #Doris 12-05-2022
          self.ui.numeroDemandeLineEdit1.setReadOnly(True)
          self.ui.coutLineEdit.setEnabled(True)
          self.ui.regionLineEdit.setReadOnly(True)
          self.ui.districtLineEdit.setReadOnly(True)
          self.ui.communeLineEdit.setReadOnly(True)
    except StandardError as e:
      print e

      #self.ui.communeComboBox.setReadOnly(True)

