          dateReconnaissance = self.ui.dateReconnaissanceDateEdit.text()
          dtReconnaissance = dateReconnaissance.split('/')
          dateReconnaissanceToInsert = datetime.date(int(dtReconnaissance[2]), int(dtReconnaissance[1]),
                                                     int(dtReconnaissance[0]))
