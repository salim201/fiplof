  def loadOpposition(self,connexion):
      cursor = connexion.cursor()
      etatopposition = 0
      self.ui.tableWidgetOppositions.setRowCount(0)
      cursor.execute("SELECT * from oppositions  where gid=%s and etatopposition = %s ", [int(self.gid),etatopposition])
      dm = cursor.fetchall()
      self.data = []
      if (len(dm) >= 1):
          OppTemp = []
          for o in dm :
              # 2018 - 05 - 09
              year, month, day = o[1].isoformat().split("-")
              dateOpposition = day + "/" + month + "/" + year

              year, month, day = o[2].isoformat().split("-")
              dateDemande = day + "/" + month + "/" + year
              data = (str(o[4]), str(o[3]), dateOpposition, dateDemande, str(o[0]))
              try:
                  self.add_values(data)
              except Exception as e:
                  print(e)

  def loadFokontany(self, idcommune,idFokontany):

    cursor = self.connection.cursor()
    cursor.execute("SELECT *  FROM fokontany  WHERE idcommune=%s", [int(idcommune)])
    dm = cursor.fetchall()
    size = len(dm)
    try:
        i = 0
        if (size >= 1):
          district = dm[0]
          self.ui.fokontanyComboBox.clear()
          for row in dm:
            nomfkt = row[3]
            self.ui.fokontanyComboBox.addItem(_fromUtf8(row[3]), row[0])
            if row[0] == idFokontany:
                self.ui.fokontanyComboBox.setCurrentIndex(i)
            i = i + 1
        else:
          self.ui.fokontanyComboBox.clear()
    except StandardError as e:
        print e
        self.connection.rollback()

  def loadHameau(self, idHameau = 0):
    idFokontany = self.utils.getComboValue(self.ui.fokontanyComboBox)
    cursor = self.connection.cursor()
    cursor.execute("SELECT *  FROM hameau  WHERE idfokontany=%s", [int(idFokontany)])
    dm = cursor.fetchall()
    size = len(dm)
    try:
        i = 0
        if (size >= 1):
          district = dm[0]
          self.ui.HameauComboBox.clear()
          for row in dm:
            nomfkt = row[3]
            self.ui.HameauComboBox.addItem(_fromUtf8(row[3]), row[0])
            if row[0] == idHameau:
                self.ui.HameauComboBox.setCurrentIndex(i)
            i = i + 1
        else:
          self.ui.HameauComboBox.clear()
    except StandardError as e:
        print e
        self.connection.rollback()

  def updateGeometrie(self):
      from Projet.journalRunn import journal
      journal = journal(self.connection)
      journal.inserToJournal(globalvars.id_user, self.iddemandeForJournal, "Demande",
                             "Edition de la geometrie d'une demande")
      # fin ecritude dans le journal
      self.close()
      try:
          self.parent.close()
      except:
          pass
      self.canvas.setMapTool(self.tool)
      self.parent.activateChangeOngeom.setEnabled(True)


