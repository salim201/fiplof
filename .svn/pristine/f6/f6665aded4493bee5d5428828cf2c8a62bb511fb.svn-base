          dateDecisionToInsert = datetime.date(int(dtDecison[2]), int(dtDecison[1]), int(dtDecison[0]))
      else:
          dateDecisionToInsert = None

      '''
      dateReconnaissance = self.ui.dateReconnaissanceDateEdit.text()
      dtReconnaissance = dateReconnaissance.split('/')
      '''

