                  print err
                  connection.rollback()
      i = j = 0

      # Enregistrement de la consistance au niveau de la parcelle liee a la demande creee nampiko kely fa ilaiko any am certificat SALIM
      try:
          if self.ui.consistanceComboBox.currentIndex() == -1:
              cursor.execute("UPDATE parcelle_d SET numdemande=(%s) WHERE gid = (%s)", (numDmd, self.idparcelle))
          else:
              consistanceParcelle = str(self.ui.consistanceComboBox.currentText())
              cursor.execute("UPDATE parcelle_d SET numdemande=(%s),consistance = (%s) WHERE gid = (%s)",
                             (numDmd, consistanceParcelle, self.idparcelle))
          connection.commit()
      except Exception as err:
          print err
          connection.rollback()
          #        last_iddemande = cursor.fetchone()[0]
          #        canvas = QgsMapCanvas()

          # Ecriture dans le journal


      from Projet.journalRunn import journal
      journal = journal(connection)
      journal.inserToJournal(globalvars.id_user, idDemandePourJournal[0], u"Demande",u"Creation de demande de Certificat")
      # Fin ecriture dans journal
      cLayer = self.parent.current_layer
      mc = self.parent.MainWindow.canvas
      #        mc = qgis.utils.iface.mapCanvas()
      for layer in mc.layers():
          if layer.type() == layer.VectorLayer:
              layer.removeSelection()

      mc.refresh()
      mc.refresh()
      mc.refresh()
      mc.refresh()
      mc.refresh()
      mc.refresh()
          # self.dialog.close()
      try:
          cursor.execute("UPDATE parcelle_d SET grille = (%s) WHERE gid = (%s)",
                         (str(self.ui.numeroGrilleLineEdit.text()), self.idparcelle))
          connection.commit()
      except Exception as err:
          print err
          connection.rollback()
      self.parent.ui.actionValidate.setEnabled(True)
      self.close()

  def initMasks(self):
    validatorNumDemande = QRegExpValidator(globalvars.regexpNumDemande)
    validatorOccupation = QRegExpValidator(globalvars.regexpNum)
    self.ui.lineEditDureeMiseEnValeur.setValidator(validatorOccupation)
    #self.ui.numeroDemandeLineEdit.setValidator(validatorNumDemande)

  def checkState(self):
      self.ui.lineEditNumDecision.setVisible(self.ui.checkBoxNumDecision.isChecked())
      self.ui.dateReconnaissanceDateEdit.setVisible(self.ui.checkBoxDateReconnaissance.isChecked())
      self.ui.dateDecision.setVisible(self.ui.checkBoxDateDecision.isChecked())
      self.ui.dateEditDebutAffichage.setVisible(self.ui.checkBoxDebutAffichage.isChecked())
      self.ui.dateEditFinAffichage.setVisible(self.ui.checkBoxFinAffichage.isChecked())

  def updateCptDemande(self):
      cursor = self.connection.cursor()
      try:
          cursor.execute(
              "UPDATE commune SET cptdemande = (SELECT (MAX(CAST(TRIM(SPLIT_PART(dmd.numdemande,'-','4')) as integer)) + 1) as ordre FROM demande dmd WHERE dmd.idcommune = %s)",
              (globalvars.id_commune,))
          self.connection.commit()
          # QMessageBox.information(None, 'Compteur Demande', u'Compteur demande mis à jour')
          print(u'compteur demande à jour')
      except Exception as err:
          # QMessageBox.critical(None, 'erreur', u'Numéro demande non conforme XXX-XX-F-XXX')
          self.connection.rollback()
          print(err)
      cursor.close()

  def openHameau(self):
      from Parametres.hameauRunn import hameauRunn
      Hameau = hameauRunn(self.connection, globalvars.id_projet)
      result = Hameau.exec_()


