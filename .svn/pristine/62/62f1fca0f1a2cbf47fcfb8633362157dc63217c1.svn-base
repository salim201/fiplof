except AttributeError:
    def _fromUtf8(s):
        return s
class OperationsSubsequentes(QtGui.QDialog):
    def __init__(self, connection, canvas, parent):
        QtGui.QDialog.__init__(self)
        # Set up the user interface from Designer.
        self.ui = Ui_Dialog()
        self.parent = parent
        self.tool = self.parent.tool
        self.idCf  = None
        self.numCf =  []
        self.geomId = None
        self.title = ""
        self.typeOp = 0
        self.id_projet = self.parent.id_projet
#       print self.parent.txt
        self.ui.setupUi(self)
        self.connection = connection
        self.canvas = canvas
        self.parent = parent
        self.layer = self.parent.cLayer
        self.actionSplit = self.parent.ui.actionSplit
        self.idActe = 0
        self.IdActeDeces = 0
        self.IdActePrivee = 0
        self.idDecision = 0
        self.IdActePublic = 0
        self.acte = ''
        self.idCertificat = []
        self.idGeom = []
        self.selectItem = ""
        self.acte = 'public'

        self.details = []
        self.initActions()
        from .ChoixTypeActeRun import ChoixTypeActe
        self.choixtype = ChoixTypeActe(self)
        #from Certificat.GestionProprietaireRun import GestionProprietaireRun
        #self.proprio = GestionProprietaireRun(self.connection)

    def initActions(self):
        self.ui.btnCahrgerActe.clicked.connect(self.chargerActe)
        self.ui.btnRechercher.clicked.connect(self.rechercheCertificat)
        self.ui.btnAjouter.clicked.connect(self.ajouterCF)
        self.ui.btnLancerOperation.clicked.connect(self.LancerOperation)
        self.ui.btnDetailActe.clicked.connect(self.detailActe)
        self.ui.btnEnlever.clicked.connect(self.removeSelectCF)
        self.ui.listWidget.itemClicked.connect(self.Clicked)

        self.loadTypeOperationSubsequente()

        validator = QtGui.QDoubleValidator()
        self.ui.lineEditCout1.setValidator(validator)
        self.ui.lineEditCout2.setValidator(validator)

        self.ui.dateEditDepotDemande.setDisplayFormat("dd/MM/yyyy")
        self.ui.dateEditDepotDemande.setDate(QDate.currentDate())

        self.ui.dateEditInscriptionRegistre.setDisplayFormat("dd/MM/yyyy")
        self.ui.dateEditInscriptionRegistre.setDate(QDate.currentDate())
        #self.ui.textEdit.setSelectionBehavior(1)

    def Clicked(self,item):
        self.selectItem = item.text()
        #QMessageBox.information(self, "ListWidget", "You clicked: " + item.text())

    def removeSelectCF(self):
        from PyQt4.QtGui import *
        from PyQt4.QtCore import *
        from PyQt4.QtGui import QDialog, QListWidgetItem
        from PyQt4 import QtGui, Qt
        print "currentText"
        if self.selectItem == "":
            QMessageBox.information(self, "Liste CF", "Veuillez selectionner un CF à enlever ")
            return
        else :
            nb = self.ui.listWidget.count()
            if ((self.ui.comboTypeOperation.currentIndex() == 2) or (self.ui.comboTypeOperation.currentIndex() == 5)):
                self.ui.btnAjouter.setEnabled(True)
            else:
                if (self.ui.comboTypeOperation.currentIndex() == 7):
                    if nb >= 2:
                        self.ui.btnAjouter.setEnabled(False)
                    else:
                        self.ui.btnAjouter.setEnabled(True)
                else:
                    self.ui.btnAjouter.setEnabled(True)

            self.ui.listWidget.takeItem(self.ui.listWidget.currentRow())

        #print self.ui.comboNumCertificat.currentText()
    def detailActe(self):
        print " self.idActe IN"
        print self.IdActeDeces

        if int(self.IdActeDeces) != 0 :
            self.idActe = self.IdActeDeces
            self.acte = 'deces'
            cursor = self.connection.cursor()
            cursor.execute("SELECT *  FROM actedeces where idactedeces = %s",[int(self.IdActeDeces)])
            dm = cursor.fetchone()
            self.details = dm
            from .ActeDecesRun import ActeDeces
            actedeces = ActeDeces(self)
            actedeces.exec_()
            print dm

        if int(self.choixtype.IdActePublic) != 0:
            self.idActe = self.choixtype.IdActePublic
            print "self self.IdActePublic"
            print self.choixtype.IdActePublic
            cursor = self.connection.cursor()
            cursor.execute("SELECT *  FROM actepublic where idactepublic = %s", [int(self.choixtype.IdActePublic)])
            dm = cursor.fetchone()
            self.details = dm

            from .ActePublicsRun import ActePublic
            actePublic = ActePublic(self)
            actePublic.exec_()

            print dm


        if int(self.choixtype.IdActePrivee) != 0 :
            self.acte = 'privee'
            self.idActe = self.choixtype.IdActePrivee
            cursor = self.connection.cursor()
            cursor.execute("SELECT *  FROM acteprive where idacteprive = %s", [int(self.choixtype.IdActePrivee)])
            dm = cursor.fetchone()
            self.details = dm
            from .ActePriveRun import ActePrive
            actePrivee = ActePrive(self)
            actePrivee.exec_()
        #QtGui.QMessageBox.warning(self, "FIPLOF", str(self.idActe))

    def LancerOperation(self):
        print " self.ui.comboTypeOperation.currentIndex()"


        if int(self.choixtype.IdActePrivee) != 0 :
            self.acte = 'privee'
            self.idActe = self.choixtype.IdActePrivee

        if int(self.choixtype.IdActePublic) != 0:
            self.idActe = self.choixtype.IdActePublic
            self.acte = 'public'
        if int(self.IdActeDeces) != 0 :
            self.idActe = self.IdActeDeces
            self.acte = 'deces'

        print self.IdActeDeces
        print self.ui.comboTypeOperation.currentIndex()
        numCF = []
        self.typeOp = self.ui.comboTypeOperation.currentIndex()
        self.idActe = self.idActe

        print "remove"
        nb = self.ui.listWidget.count()
        i = 0
        while i < nb:
            item = self.ui.listWidget.item(i)
            if item == None:
                print "NoneType iz"
            else:
                print " item.data() "
                print item.data(0).toString()
                numCF.append(item.data(0).toString())
            # print item.getText()
            i = i + 1
        #numCF = self.ui.textEdit.toPlainText()
        #numCF = numCF.split('\n')
        self.numCf = numCF
        print "len CF"
        print len(numCF)

        if self.idActe == 0 :
            QtGui.QMessageBox.warning(self, "FIPLOF", "Veuillez charger acte")
            return


        if self.ui.lineEditCout1.text() == "":
            QtGui.QMessageBox.warning(self, "FIPLOF", "Veuillez remplir ce champ")
            self.ui.lineEditCout1.setFocus(Qt.Qt.OtherFocusReason)
            return True
        #if self.ui.textEdit.text() == "":
        #    QtGui.QMessageBox.warning(self, "FIPLOF", "Veuillez remplir ce champ")
        #    self.ui.textEdit.setFocus(Qt.Qt.OtherFocusReason)
        #    return False

        if self.ui.lineEditCout2.text() == "":
            QtGui.QMessageBox.warning(self, "FIPLOF", "Veuillez remplir ce champ")
            self.ui.lineEditCout2.setFocus(Qt.Qt.OtherFocusReason)
            return True

        if len(self.numCf) >= 1:
            print "continue"
        else :
            QtGui.QMessageBox.warning(self, "FIPLOF", "Veuillez ajouter le Certificat en cause ")
            self.ui.textEdit.setFocus(Qt.Qt.OtherFocusReason)
            return False

        print "LEN self.numCf"
        print len(self.numCf)

        if self.ui.comboTypeOperation.currentIndex() == 7:
            if len(self.numCf) <= 1 :
                QtGui.QMessageBox.warning(self, "FIPLOF", "Au moins  ajouter deux certificats pour l'échange")
                self.ui.textEdit.setFocus(Qt.Qt.OtherFocusReason)
                return False
        if self.ui.comboTypeOperation.currentIndex() == 8:
            if len(self.numCf) <= 1:
                QtGui.QMessageBox.warning(self, "FIPLOF", "Au moins  ajouter deux certificats pour la fusion")
                self.ui.textEdit.setFocus(Qt.Qt.OtherFocusReason)
                return False
        print "self.ui.textEdit"
        #print self.ui.textEdit.toPlainText()
        #print numCF[0]
        #print numCF[1]
        #print self.ui.textEdit.text()
        if len(self.numCf) >= 1 :
            i = 0
            n = len(self.numCf)
            while(i < n):
                print " numCF[i]"
                print numCF[i]
                cursor = self.connection.cursor()
                cursor.execute("SELECT *  FROM certificat where numerocertificat =%s ",[str(numCF[i])])
                rs = cursor.fetchone()
                self.numD = rs[1]
                self.idCertificat.append(rs[8])
                #self.idCertificat = rs[8] # idcertificat
                print "RS cf"
                print rs

                idcf = rs[8]
                cursor.execute("SELECT *  FROM parcelle_d where idcertificat =%s ", [int(idcf)])
                row = cursor.fetchone()



                #idCf = self.numD.split('-')
                idgeom = row[0] # idparcelle
                self.idGeom.append(idgeom)
                #self.idGeom = idgeom
                print idgeom
                i = i + 1
            #self.geomId = rs[0]


            canvas = self.canvas
            #cLayer = self.canvas.currentLayer()
            cLayer = self.layer
            self.close()
            #for layer in canvas.layers():
            #    if layer.type() == layer.VectorLayer:
            #        layer.removeSelection()

            #canvas.refresh()
            #cLayer.select(int(idgeom))
            #canvas.zoomToSelected(cLayer)
            #zoomToGeom

        else :
            print "None"


        if self.ui.comboTypeOperation.currentIndex() == 0:
            from .proprioMutationRun import proprioMutation
            self.title = "Mutation par décès"
            self.typeOp = 0
            proprioMutation = proprioMutation(self)
            proprioMutation.exec_()

        if self.ui.comboTypeOperation.currentIndex() == 1:
            from .VenteTotaleRun import VenteTotaleRun
            self.title = "Vente Total"
            self.typeOp = 1
            venteTotal = VenteTotaleRun(self)
            venteTotal.exec_()

        if self.ui.comboTypeOperation.currentIndex() == 3:
            from .VenteTotaleRun import VenteTotaleRun
            self.title = " Vente partielle en restant dans l'indivision"
            self.typeOp = 3
            venteTotal = VenteTotaleRun(self)
            venteTotal.exec_()

        if self.ui.comboTypeOperation.currentIndex() == 4:
            from .VenteTotaleRun import VenteTotaleRun
            self.typeOp = 4
            self.title = "Donation totale d'un certificat "

            venteTotal = VenteTotaleRun(self)
            venteTotal.exec_()


        if self.ui.comboTypeOperation.currentIndex() == 5:
            self.parent.ui.actionSplit.setEnabled(True)
            self.parent.NumeroCF = numCF[0]

        if self.ui.comboTypeOperation.currentIndex() == 6:
            from .VenteTotaleRun import VenteTotaleRun
            self.typeOp = 6
            self.title = "Donation partielle en restant dans l'indivision"
            venteTotal = VenteTotaleRun(self)
            venteTotal.exec_()

        if self.ui.comboTypeOperation.currentIndex() == 7:
            print " comboTypeOperation "
            from .EchangeTotalRun import EchangeTotalRun
            echangeTotal = EchangeTotalRun(self)
            echangeTotal.exec_()

        #if self.ui.comboTypeOperation.currentIndex() == 8:
