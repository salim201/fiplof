        #    vente = PartageCFRun(self)
        #    vente.exec_()



        #if self.ui.comboTypeOperation.currentIndex() == 9:
        #    #from .PartageCFRun import PartageCFRun
        #    self.typeOp = 9
        #    self.title = "Partage avec distraction"
        #    self.parent.ui.actionSplit.setEnabled(True)
        #    self.parent.NumeroCF = numCF[0]

        if self.ui.comboTypeOperation.currentIndex() == 8:
            # from .PartageCFRun import PartageCFRun
            self.typeOp = 10
            self.title = "Fusion des certificats"
            self.parent.ui.actionMerge.setEnabled(True)
            #self.parent.NumeroCF = numCF[0]
            self.parent.NumeroCF = self.numCf


        if self.ui.comboTypeOperation.currentIndex() == 2:
            self.parent.ui.actionSplit.setEnabled(True)
            self.typeOp = 2

            self.parent.NumeroCF = numCF[0]
            self.parent.typeOp = self.ui.comboTypeOperation.currentIndex()
            self.parent.idActe = self.idActe
            self.parent.acte = self.acte

            #from .ProprioRun import Proprio
            #Prop = Proprio(self)
            #Prop.exec_()
        return True

    def ajouterCF(self):
        import sys
        from PyQt4.QtGui import *
        self.numCf = self.ui.comboNumCertificat.currentText()
        #self.ui.textEdit.setText(self.numCf)
        item = QListWidgetItem(self.numCf)
        nb = self.ui.listWidget.count()
        if ((self.ui.comboTypeOperation.currentIndex() == 2) or (self.ui.comboTypeOperation.currentIndex() == 5)):
            if nb == 1 :
                QMessageBox.information(self, "Liste CF", "Veuillez supprimer le CF dans la liste ")
                self.ui.btnAjouter.setEnabled(False)
                return
            if nb == 0 :
                self.ui.btnAjouter.setEnabled(True)
                self.ui.listWidget.addItem(item)
        else :
            if (self.ui.comboTypeOperation.currentIndex() == 7):

                if nb >= 2:
                    self.ui.btnAjouter.setEnabled(False)
                else:
                    self.ui.btnAjouter.setEnabled(True)
                    self.ui.listWidget.addItem(item)
            else :
                self.ui.listWidget.addItem(item)



        #listWidget.addItem(item)
        print self.ui.comboNumCertificat.currentIndex()


    def loadTypeOperationSubsequente(self):
        cursor = self.connection.cursor()
        cursor.execute("SELECT *  FROM typeoperationsubsequente ")
        dm = cursor.fetchall()
        for row in dm:
            self.ui.comboTypeOperation.addItem(_fromUtf8(row[1]), row[0])

    def chargerActe(self):
        print "chargerActe"
        print self.ui.comboTypeOperation.currentIndex()
        if self.ui.comboTypeOperation.currentIndex() == 0:
            from .ListeActeDecesRun import ListeActeDeces
            listeacte = ListeActeDeces(self)
            listeacte.exec_()
        elif 1 <= self.ui.comboTypeOperation.currentIndex() <= 3 or 7 <= self.ui.comboTypeOperation.currentIndex() <= 9:
            print "Charger acte ici"
            self.choixtype.exec_()
        elif 4 <= self.ui.comboTypeOperation.currentIndex() <= 6:
            from .ListeActePublicsRun import ListeActePublics
            listeacte = ListeActePublics(self)
            listeacte.exec_()
       # elif self.ui.comboTypeOperation.currentIndex() == 10:

    def rechercheCertificat(self):
        from Certificat.RechercheCFRun import RechercheCFRun

        rechercheCF = RechercheCFRun(self.connection,self.canvas, self.parent,self)
        rechercheCF.exec_()




