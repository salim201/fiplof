    def increaseTransparency(self):
        layer = self.GeorefLayer
        # clamp to 100
        if self.GeorefLayer != None:
            tr = min(layer.transparency + 10, 100)
            layer.transparencyChanged(tr)

    def decreaseTransparency(self):
        layer = self.GeorefLayer
        # clamp to 0
        if self.GeorefLayer != None:
            tr = max(layer.transparency - 10, 0)
            layer.transparencyChanged(tr)

