    def initLayers(self):
        QApplication.setOverrideCursor(Qt.WaitCursor)
        self.ui.listWidget.clear()
        if self.layers:
            del self.layers[:]
        if self.vectors:
            del self.vectors[:]
        self.layers = []
        self.vectors = []
        QgsMapLayerRegistry.instance().removeAllMapLayers()
        self.createCanvas()
        layersCollection = PlofLayersCollection(globalvars.id_commune)
        plofStandardLayers = layersCollection.getStandardLayers()
        for layer in plofStandardLayers:
            shape = self.loadGeom(layer)
            if shape is not None:
                self.layers.append(shape)

        couches = ProjetCouche.find_by_projet_commune(self.connection, globalvars.id_projet_commune)
        for couche in couches:
            if couche.type_couche == 'R':
                shape = self.loadRaster(couche.fichier, couche.libelle, couche.id, couche.idprojet_commune)
                if shape:
                    self.layers.append(shape)
            if couche.type_couche == 'S':
                print "shape IN"
                print couche.couleur_bg
                print "couche.couleur_bg OUT"
                print("COUCHE PLOF_PAPS")
                print(couche.plofpaps)

                shape = self.loadShape(
                    _fromUtf8(couche.fichier)
                    , couche.libelle
                    , couche.couleur_bg
                    , couche.id
                    , couche.idprojet_commune
                    , couche
                    , couche.remplissage
                    , couche.plofpaps
                )
                if shape:
                    self.layers.append(shape)



        self.displayLayers()
        self.cLayer = self.MainWindow.canvas.currentLayer()
        from processing.tests.qgis_interface import QgisInterface
        self.iface = QgisInterface(self.MainWindow.canvas)

        self.canvas = self.MainWindow.canvas
        self.Mcs = self.MainWindow.canvas
        self.canvas.setCanvasColor(Qt.darkCyan)


        canvas = self.MainWindow.canvas
        canvas.refresh()
        #self.canvas.setCanvasColor(Qt.darkCyan)
        #self.msgBar = QgsMessageBar()
        #self.msgBar.pushMessage("...", " Bienvenue sur le logiciel PLOF-FIPLOF ...", level=QgsMessageBar.SUCCESS)

        self.TrackEditTool = EditTrackTool(self.MainWindow.canvas, self.cLayer,self.onTrackEdited)
        #self.LatLon = CoordinatesPoints(self.iface, self.MainWindow.canvas, self)
#        self.MainWindow.canvas.setMapTool(self.LatLon)
        self.tool_zoom_in = QgsMapToolZoom(self.MainWindow.canvas, False)
        self.tool_zoom_out = QgsMapToolZoom(self.MainWindow.canvas, True)
        self.tool_pan = QgsMapToolPan(self.MainWindow.canvas)
        self.tool_move = MovePointTool(self.MainWindow.canvas, self.cLayer)
        self.toolPoint = QgsMapToolEmitPoint(self.MainWindow.canvas)
        self.toolPoint.canvasClicked.connect(self.toolPointClicked)
        if len(self.registry.mapLayersByName("Fiscalite")):
            self.fiscalite = self.registry.mapLayersByName("Fiscalite")[0]
        if len(self.registry.mapLayersByName("Titre")):
            self.titre = self.registry.mapLayersByName("Titre")[0]
        if len(self.registry.mapLayersByName("Cadastre")):
            self.cadastre = self.registry.mapLayersByName("Cadastre")[0]
        if len(self.registry.mapLayersByName("Demande FN")):
            self.demande_fn = self.registry.mapLayersByName("Demande FN")[0]
        if len(self.registry.mapLayersByName("TSS")):
            self.tss = self.registry.mapLayersByName("TSS")[0]

        self.tool_identify_geometry = IdentifyGeometry(self.MainWindow.canvas, self)
        QObject.connect(self.tool_identify_geometry, SIGNAL("geomIdentified"), self.showInfos)
        self.tool_select_geometry = IdentifyGeometry(self.MainWindow.canvas, self)
        QObject.connect(self.tool_select_geometry, SIGNAL("geomIdentified"), self.doSometing)
        QApplication.restoreOverrideCursor()

