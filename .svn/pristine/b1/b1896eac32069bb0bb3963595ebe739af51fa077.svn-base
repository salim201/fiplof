    def deleteOldGeometri(self):
        processLayer = self.cLayer
        pkFld = processLayer.pendingPkAttributesList()[0]
        cur = self.connection.cursor()
        for aFeat in processLayer.selectedFeatures():
            gid= aFeat.id()
            print "aFeat.id() IN"
            print gid
            cur.execute("SELECT idcertificat from parcelle_d  WHERE  gid=%s", [int(gid)])
            dm = cur.fetchone()
            if dm[0] != None:
                self.cLayer.startEditing()
                cur.execute("delete from proprietaireparcelle_d WHERE idparcelle=%s", [int(gid)])
                cur.execute("delete from  avoir_dmd WHERE gid=%s", [int(gid)])
                cur.execute("delete from  oppositions WHERE gid=%s", [int(gid)])
                cur.execute("delete from  demande WHERE gid=%s", [int(gid)])
                cur.execute("delete from  parcelle_d WHERE gid=%s", [int(gid)])
                cur.execute("delete from  certificat WHERE idcertificat=%s", [int(dm[0])])
                self.connection.commit()
                self.cLayer.commitChanges()

                # if hasCF[0] != None :
                #    print  "demande de confirmation par saisie code"
                #    from BeforeDelRun import BeforeDelRun
                #   z = BeforeDelRun(self)
                #    result = z.exec_()
                # else :
                #self.cLayer.deleteFeature(int(gid))
        for layer in self.canvas.layers():
            if layer.type() == layer.VectorLayer:
                layer.removeSelection()
        self.canvas.refresh()
        self.reloadCanvas()



    def addNewGeometri(self,geometry):

        x = None
        self.idparcelle = 0

        strgeom = ""
        self.ok = 0
        if (geometry.isGeosValid()) :
            if geometry.wkbType() == QGis.WKBPolygon:
                x = geometry.asPolygon()
            if geometry.wkbType() == QGis.WKBMultiPolygon:
                x = geometry.asMultiPolygon()[0]
            cur = self.connection.cursor()
            try:
                num = ""
                exe = cur.execute(
                    "INSERT INTO parcelle_d (numero,geom,surface ,id_commune)VALUES (%s, ST_GeomFromText(%s, " + str(
                        globalvars.EPSG_SCR) + "),ST_Area(%s), %s) returning gid,surface",
                    (num, str(geometry.exportToWkt()), str(geometry.exportToWkt()), globalvars.id_commune))
                self.connection.commit()
                dm = cur.fetchone()
                if (len(dm) > 0):
                    self.ok = 1
                    self.iddemande = dm[0]
                    self.idparcelle = dm[0]
                    self.currentGeomIdParcelle = dm[0]
                    self.currvalDemande = self.iddemande
            except Exception as e:
                self.connection.rollback()
                return
                print(e)
        return self.idparcelle





    def MergeLayer(self):
        print "Merge Layer"

        where = "estfiscalite is null or estfiscalite = 0 or conversion = 1"
        # where = lf.loadGeom("public", "parcelle_d", "geom", "numerodmdpaps", "Demandes Parcelle", style1, 1, where="estfiscalite is null or estfiscalite = 0 or conversion = 1", layer_index=0)
        uri = QgsDataSourceURI()
        uri.setConnection(db_config.db_host, db_config.db_port, db_config.db_name, db_config.db_user, db_config.db_pass)
        if where is not None:
            uri.setDataSource("public", "parcelle_d", "geom")
        key_column = 'gid'
        uri.setKeyColumn(key_column)
        layer = QgsVectorLayer(uri.uri(), "Demandes Parcelle", "postgres")

        if not layer.isValid():
            # print "LAYER is not valide "+ where
            # print ("\tFailed loading %s. Trying to set wkbtype and key column to %s" % (table, key_column))
            uri.setWkbType(QGis.WKBPolygon)
            uri.setSrid(str(globalvars.EPSG_SCR))
            layer = QgsVectorLayer(uri.uri(), "Demandes Parcelle", "postgres")
            if not layer.isValid():
                print("\t\tFailed loading %s even with wkbtype set")
                return None
        #crs = QgsCoordinateReferenceSystem(29702, QgsCoordinateReferenceSystem.EpsgCrsId)
        #layer.setCrs(crs)
        wkt = 'PROJCS["Madagascar_Laborde_Tan1925",GEOGCS["GCS_Tananarive_1925",DATUM["D_Tananarive_1925",SPHEROID["International_1924",6378388.0,297.0]],PRIMEM["Greenwich",0.0],UNIT["Degree",0.0174532925199433]],PROJECTION["Hotine_Oblique_Mercator_Azimuth_Center"],PARAMETER["False_Easting",400000.0],PARAMETER["False_Northing",800000.0],PARAMETER["Scale_Factor",0.9995],PARAMETER["Azimuth",18.9],PARAMETER["Longitude_Of_Center",46.43722917],PARAMETER["Latitude_Of_Center",-18.9],UNIT["Meter",1.0]]'
        #crs = QgsCoordinateReferenceSystem(wkt)
        crs = QgsCoordinateReferenceSystem(globalvars.EPSG_SCR, QgsCoordinateReferenceSystem.EpsgCrsId)
        layer.setCrs(crs)
        self.Varlayer = layer
        processLayer = self.cLayer
        parcelleid = []
        print self.NumeroCF
        pkFld = processLayer.pendingPkAttributesList()[0]
        print "PKLD "
        print pkFld
        geoms = QgsGeometry.fromWkt('GEOMETRYCOLLECTION EMPTY')
        processLayer.beginEditCommand(
            QtCore.QCoreApplication.translate("editcommand",
                                              "Merge Features"))

        for aFeat in processLayer.selectedFeatures():
            self.parcelleMerge.append(aFeat.id())
        self.proccesLayer =  processLayer.selectedFeatures()
        from OperationsSubsequentes.FusionRun import  FusionRun
        f = FusionRun(self)
        f.exec_()
        for aFeat in processLayer.selectedFeatures():
            print "SELECTED FEATURE ID"
