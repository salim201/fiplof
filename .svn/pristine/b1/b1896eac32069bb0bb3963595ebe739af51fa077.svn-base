        self.cLayer = fiscalite
        self.MainWindow.canvas.setCurrentLayer(fiscalite)
        reply = QMessageBox.question(self.MainWindow, "Confirm",
                                     "Voulez-vous creer une parcelle pour un traitement de fiscalite?",
                                     QMessageBox.Yes | QMessageBox.No, QMessageBox.Yes)
        if reply == QMessageBox.Yes:
            cp = CaptureTool(self.MainWindow.canvas, fiscalite, self.onGeometryAdded, 2, self.MainWindow, None, sender, self)
            self.MainWindow.canvas.setMapTool(cp)
        else:
            print("OK")

