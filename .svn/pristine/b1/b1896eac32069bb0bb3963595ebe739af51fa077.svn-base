    def deconnexionFisc(self, bypass=False):
        reply = QMessageBox.Yes
        if not bypass:
            reply = QMessageBox.question(
                self.MainWindow, "Deconnexion",
                "Voulez-vous vous deconnecter du module Fiscalite ?",
                QMessageBox.Yes | QMessageBox.No, QMessageBox.Yes
            )
        if reply == QMessageBox.No:
            return
        self.ui.menu_Saisie_Des_Donn_es.setEnabled(False)
        self.ui.menuCalcul_Impots.setEnabled(False)
        self.ui.menuAutres.setEnabled(False)
        self.ui.menuParam_tres.setEnabled(False)
        self.ui.action_Connexion.setEnabled(True)
        self.ui.actionD_connexion.setEnabled(False)
        self.labelConnectedAs.setText("")

