    def removeVertex(self):
        print ("delete current Vertex when del pressed")
        print (self.vertexIndex)
        if self.vertexIndex is None: return
        if self.feature is None: return
        if not self.crrGeom: return
        if not self.currentVertex : return
        x = self.crrGeom[0]
        print ("array of self.currentGeom")
        print (self.crrGeom)
        self.canvas.scene().removeItem(self.markersMultiEdit[self.vertexIndex])
        print (self.vertexIndex)
        #self.currentGeom.remove(self.currentGeom[0][self.vertexIndex])
        self.crrGeom[0].remove(self.crrGeom[0][self.vertexIndex])
        newgeom = QgsGeometry.fromPolygon(self.crrGeom)
        geom = self.feature.geometry()
        self.layer.changeGeometry(self.feature.id(), newgeom)
        self.geometryeEdit = self.crrGeom
        self.TheGeom = newgeom
        self.GeomId = self.feature.id()
        self.canvas.refresh()
        self.layer.triggerRepaint()

    def CurrentCommune(self):
        self.cursor = self.connection.cursor()
        nomCommune = ""
        dm = None
        try:
            self.cursor.execute("SELECT * FROM commune  WHERE idcommune=%s", [int(globalvars.id_commune)])
            dm = self.cursor.fetchone()
            if dm is not None:
                if len(dm) > 1:
                    nomCommune = str(dm[3])
        except Exception as err:
            print (err)
            self.connection.rollback()

        login_user = ""
        group_user = ""
        try:
            self.cursor.execute("SELECT u.loginutilisateur, g.nom FROM utilisateur u INNER JOIN groupe g ON u.groupe_id = g.id  WHERE idutilisateur=%s", [int(globalvars.id_user)])
            res = self.cursor.fetchone()
            if res is not None:
                login_user = str(res[0]).strip()
                group_user = str(res[1]).strip()
        except Exception as err:
            print (err)
            self.connection.rollback()



        if nomCommune != "" or login_user != "":
            print('nom-COMMUNE')
            print(nomCommune)
            self.MainWindow.setWindowTitle(_fromUtf8(" MATSF/DGSF/DST - FIPLOF commune - ")+nomCommune+" /UTILISATEUR: "+ login_user + " /GROUPE: " + group_user)
        else:
            print("do nothing")

