            self.displayLayers()

    def addShape(self):
        import sys
        reload(sys)
        sys.setdefaultencoding('utf8')

        filename = QtGui.QFileDialog.getOpenFileName(self.MainWindow, "Choisissez un fichier shape")
        if not filename:
            return
        shape = self.loadShape(_fromUtf8(filename))
        if shape is not None:
            self.layers.append(shape)
            self.displayLayers()

    def delRaster(self):
        index = self.ui.listWidget.currentIndex().row()
        if index <= 2:
            return
        reply = QMessageBox.question(
            self.MainWindow,
            "Confirm",
            "Voulez-vous supprimer la couche ?",
            QMessageBox.Yes | QMessageBox.No, QMessageBox.Yes
        )
        if reply == QMessageBox.No:
            return
        self.ui.listWidget.takeItem(index)
        self.vectors.pop(index)
        self.layers.__delitem__(index)
        self.displayLayers()

    def editLayerProperties(self):
        index = self.ui.listWidget.currentIndex()
        if not index.isValid():
            return
        row = index.row()
        if row <= 5:
            self.editPredefinedLayer(row)
        else:
            self.editProjectLayer(row)

    def editProjectLayer(self, row):
        couche_id = self.ui.listWidget.item(row).data(QtCore.Qt.UserRole + 1).toInt()[0]
        idprojet_commune = self.ui.listWidget.item(row).data(QtCore.Qt.UserRole + 2).toInt()[0]
        if not couche_id or not idprojet_commune:
            return
        from Projet.AddLayerRun import AddLayerRun
        dialog = AddLayerRun(self.connection, idprojet_commune, couche_id)
        if dialog.exec_():
            self.initLayers()

    def editPredefinedLayer(self, row):
        from Parametres.Layer import Layer
        dialog = Layer(self.connection, row)
        if dialog.exec_():
            self.initLayers()

