    def enableGeoreferencer(self):
        self.ui.toolBarGeoref.setVisible(self.ui.actionGeoreferencement.isChecked())

    def _enableGeoreferencer(self):

        #from FreehandRasterGeoreferencer.freehandrastergeoreferencer import FreehandRasterGeoreferencer
        #freehandGeo = FreehandRasterGeoreferencer(self.iface)
        #freehandGeo.initGui(self.MainWindow)
        if not self.formGeoreferencer:
            from georeferencer import GeoReferencerRun
            self.formGeoreferencer = GeoReferencerRun.GeoReferencerRun()
            self.formGeoreferencer.pointAddedSignal.connect(self.georeferencerPointClicked)
            self.formGeoreferencer.pointRemovedSignal.connect(self.georeferencerPointRemoved)
            self.formGeoreferencer.referenceTerminatedSignal.connect(self.georeferenceTerminated)
            self.prev_width = self.ui.dockWidgetGeoreferencer.minimumWidth()
        self.ui.verticalLayoutGeoreferencer.addWidget(self.formGeoreferencer)


        if self.ui.actionGeoreferencement.isChecked():
            print (" at georeferencement code ")
            self.ui.dockWidgetGeoreferencer.show()
            self.ui.dockWidget.close()
        else:
            self.ui.dockWidgetGeoreferencer.close()
            self.ui.dockWidget.show()

    def georeferencerPointClicked(self, point):
        self.MainWindow.canvas.setMapTool(self.toolPoint)

    def georeferencerPointRemoved(self, point):
        self.MainWindow.canvas.scene().removeItem(point)

    def toolPointClicked(self, point, button):
        self.formGeoreferencer.setDestination(point, self.MainWindow.canvas)

