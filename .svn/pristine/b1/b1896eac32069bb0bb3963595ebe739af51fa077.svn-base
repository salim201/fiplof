    def CreateNewParcelleCertificat(self, idparcelle,newParcelle = False):
        print ("Nouvelle delimitation de certificat")
        self.idparcelle = idparcelle
        print ("self.idparcelle")
        print (self.idparcelle)
        sender = 3 # Nouvelle delimitation de certificat
        #vtlayer = self.registry.mapLayersByName("Certificats")[0]
        #self.MainWindow.canvas.setCurrentLayer(vtlayer)
        #cLayer = self.MainWindow.canvas.currentLayer()
        #cLayer = self.MainWindow.canvas.currentLayer() suite au layer de georeferencement
        cLayer = self.cLayer
        self.newParcelleCF = newParcelle
        reply = QMessageBox.question(self.MainWindow, "Confirm",
                                     "Voulez-vous creer une nouvelle delimitation pour le certificat?",
                                     QMessageBox.Yes | QMessageBox.No, QMessageBox.Yes)
        if reply == QMessageBox.Yes:
            item = self.ui.listWidget.item(0)
            self.ui.listWidget.setItemSelected(item, True)
            self.listWidgetItemClicked(item)

            print(self.current_layer)
            #self.reloadCanvas()
            print ("Nouvelle delimitation de parcelle")
            #cLayer = self.canvas.currentLayer()
            print (cLayer)
            # cLayer.select(ID)
            # cLayer.setSelectedFeatures([ID])
            # self.cvs.zoomToSelected(cLayer)
            print ("TONGA ETO")


            for layer in self.canvas.layers():
                print (" in layer loop in ")
                if layer.type() == layer.VectorLayer:
                    layer.removeSelection()

            self.canvas.refresh()
            cLayer.select(int(idparcelle))


            self.canvas.zoomToSelected(cLayer)


            cp = CaptureTool(self.MainWindow.canvas, cLayer, self.onGeometryAdded, 2, self.MainWindow, None, sender, self)
            self.cpTool = cp
            print(cp)

            # Rendre transparent la delimitation a remplacer
            renderTitre = self.cLayer.rendererV2()
            style1 = {'color': '255,0,0,0', 'outline_color': '93,182,255,255', 'outline_width': '0.3'}
            mySymbol2 = QgsFillSymbolV2.createSimple(style1)
            if renderTitre:
                renderTitre.setSymbol(mySymbol2)

            cLayer.setCustomProperty("labeling", "pal")
            cLayer.setCustomProperty("labeling/enabled", "true")
            cLayer.setCustomProperty("labeling/fontFamily", "Arial")
            cLayer.setCustomProperty("labeling/fontSize", "8")
            # layer.setCustomProperty("labeling/fontWeight", "Bold")
            cLayer.setCustomProperty("labeling/fieldName", 'numdemande')
            cLayer.setCustomProperty("labeling/placement", "OverPoint")
            self.reloadCanvas()
            self.canvas.setMapTool(self.tool)
            # Fin
            self.MainWindow.canvas.setMapTool(cp)



        else:
            print("OK")

