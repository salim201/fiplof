    def refreshCanvas(self):

        canvas = self.MainWindow.canvas
        for layer in canvas.layers():
            if layer.type() == layer.VectorLayer:
                layer.removeSelection()
                layer.triggerRepaint()
        canvas.refresh()

        for layer in self.canvas.layers():
            if layer.type() == layer.VectorLayer:
                layer.removeSelection()
        self.canvas.refresh()
        self.reloadCanvas()
        try :

            if self.cpTool is not None and self.cpTool != "" :
                self.cpTool.balayerCanvas()
            if self.CpArea is not None  :
                self.CpArea.balayerCanvas()
            if self.xlsXY is not None :
                self.xlsXY.removeMarkers()
            print " RELOAD CANVAS"
        except Exception as e:
            print(e)

