    def manageLayer(self):
        idx = self.cLayerRun.ui.choisirCoucheComboBox.currentIndex()
        for layer in self.canvas.layers():
            if layer.type() == layer.VectorLayer:
                layer.removeSelection()

        self.reloadCanvas()
        self.canvas.refresh()
        self.cLayer.triggerRepaint()
        self.CurrIndxLayer = idx
        if idx == 1:
            self.LayerToEdit = self.cLayer
            self.currLayerIndicator = None
            self.canvas.setCurrentLayer(self.cLayer)
        if idx == 2:
            fiscalite = self.registry.mapLayersByName("Fiscalite")[0]
            self.LayerToEdit = fiscalite
            self.currLayerIndicator = -2
            self.canvas.setCurrentLayer(self.cLayer)
        if idx == 3:
            self.LayerToEdit = self.cLayer
            self.canvas.setCurrentLayer(self.cLayer)
        if idx == 4:
            titre = self.registry.mapLayersByName("Titre")[0]
            self.LayerToEdit = titre
            self.currLayerIndicator = -4
            self.canvas.setCurrentLayer(self.cLayer)
        if idx == 5:
            cadastre = self.registry.mapLayersByName("Cadastre")[0]
            self.LayerToEdit = cadastre
            self.currLayerIndicator = -5
            self.canvas.setCurrentLayer(self.cLayer)
        if idx == 6:
            demande_fn = self.registry.mapLayersByName("Demande FN")[0]
            self.LayerToEdit = demande_fn
            self.currLayerIndicator = -6
            self.canvas.setCurrentLayer(self.cLayer)

        self.tool = MultipleLayersEditNodesButton(self.iface, self.MainWindow.canvas, self)
        if idx != 0:
            self.MainWindow.canvas.setMapTool(self.tool)
            self.ui.actionEnregistrer.setEnabled(True)
        else :
            QMessageBox.critical(self.MainWindow.canvas, "Erreur", "Veuillez choisir couche")
            return

    def eventFilter(self, source, event):
        if event.type() == QtCore.QEvent.MouseMove:
            if event.buttons() == QtCore.Qt.NoButton:
                pos = event.pos()
                print (" POSX IN")
                print (pos.x())
                #self.edit.setText('x: %d, y: %d' % (pos.x(), pos.y()))
            else:
                pass  # do other stuff
        return QtGui.QMainWindow.eventFilter(self, source, event)
