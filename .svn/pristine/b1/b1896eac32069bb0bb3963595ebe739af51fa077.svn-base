    def contextMenuListWidget(self, position):
        index = self.ui.listWidget.currentIndex().row()
        couche_id = self.ui.listWidget.item(index).data(QtCore.Qt.UserRole + 1).toInt()[0]
        idprojet_commune = self.ui.listWidget.item(index).data(QtCore.Qt.UserRole + 2).toInt()[0]
        menu = QMenu()
        zoomAction = menu.addAction("Zoomer sur la couche")
        editAction = menu.addAction("Editer")
        transparentAction = menu.addAction("Transparence")
        consulterAction = menu.addAction("Consulter la table")
        menu.addSeparator()
        delAction = menu.addAction("Supprimer")
        icon1 = QtGui.QIcon()
        icon2 = QtGui.QIcon()
        icon3 = QtGui.QIcon()
        icon4 = QtGui.QIcon()
        icon5 = QtGui.QIcon()
        icon1.addPixmap(QtGui.QPixmap(":/std/icone/magnifier-zoom-fit.png"), QtGui.QIcon.Normal, QtGui.QIcon.Off)
        icon2.addPixmap(QtGui.QPixmap(":/sig/icone/layer_del.png"), QtGui.QIcon.Normal, QtGui.QIcon.Off)
        icon3.addPixmap(QtGui.QPixmap(":/std/icone/if_pencil_14623.png"), QtGui.QIcon.Normal, QtGui.QIcon.Off)
        icon4.addPixmap(QtGui.QPixmap(":/sig/icone/layer-transparent.png"), QtGui.QIcon.Normal, QtGui.QIcon.Off)
        icon5.addPixmap(QtGui.QPixmap(":/std/icone/listing.png"), QtGui.QIcon.Normal, QtGui.QIcon.Off)

        zoomAction.setIcon(icon1)
        delAction.setIcon(icon2)
        editAction.setIcon(icon3)
        transparentAction.setIcon(icon4)
        consulterAction.setIcon(icon5)


        editAction.setEnabled(couche_id and idprojet_commune)
        delAction.setEnabled(index > 5)
        consulterAction.setEnabled( index >= 0 and index  < 3)

        action = menu.exec_(self.ui.listWidget.mapToGlobal(position))
        if action == zoomAction:
            self.zoomOnLayer()
        if action == delAction:
            self.delRaster()
        if action == editAction:
            self.editProjectLayer(index)
        if action == transparentAction:
            self.editTransparence()
        if action == consulterAction:
            self.showListTable(index)

    def showListTable(self,index):
        if index == 0 :
            self.rechercheDemande()
        if index == 1 :
            self.rechercherCF()
        if index == 2 :
            self.listeShow()


    def zoomOnLayer(self):
        selected = self.ui.listWidget.selectedItems()[0]
        for idx in range(0, self.ui.listWidget.count()):
            if selected == self.ui.listWidget.item(idx):
                self.MainWindow.canvas.setExtent(self.vectors[idx].extent())
                # print "couche selected"
                # print (self.vectors[idx].name())
                # print (self.vectors[idx].extent())
                self.MainWindow.canvas.refresh()
                break

