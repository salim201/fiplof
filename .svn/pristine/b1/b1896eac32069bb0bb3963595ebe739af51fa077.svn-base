    def changeScale(self):
        self.MainWindow.canvas.zoomScale(1000)

    def createCanvas(self):
        if not self.MainWindow.canvas:
            self.MainWindow.canvas = QgsMapCanvas()
            self.MainWindow.canvas.setSelectionColor(QtGui.QColor(str(globalvars.SelectionColor)))
        self.MainWindow.setCentralWidget(self.MainWindow.canvas)

        self.MainWindow.canvas.show()
        self.MainWindow.canvas.mapUnits()
        self.MainWindow.canvas.setMapUnits(QGis.Meters)
        self.MainWindow.canvas.zoomScale(500)

    def editLayer(self):
        if not self.ui.actionEditing_Node_Layers.isChecked():
            return
        if self.cLayerRun.exec_():
            self.manageLayer()
            self.ui.actionValidate.setEnabled(True)
            self.MainWindow.canvas.refresh()
        else:
            self.ui.actionValidate.setEnabled(False)
            self.ui.actionEditing_Node_Layers.setChecked(False)

