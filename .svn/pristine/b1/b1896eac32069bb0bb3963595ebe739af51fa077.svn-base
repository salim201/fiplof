    def reloadCanvas(self):
        cvs = self.MainWindow.canvas
        for layer in cvs.layers():
            layer.triggerRepaint()
        cvs.refresh()

    def displayLayers(self, set_extent=True):
        layers = []
        extent = QgsRectangle()
        extent.setMinimal()
        for index in range(self.ui.listWidget.count()):
            if self.ui.listWidget.item(index).checkState() > 0:
                if self.layers[index] is None:
                    continue
                layers.append(self.layers[index])
                extent.combineExtentWith(self.layers[index].layer().extent())
        self.MainWindow.canvas.setLayerSet(layers)
        if set_extent:
            self.MainWindow.canvas.setExtent(extent)
        #if self.clayer
        #    self.MainWindow.canvas.zoomToSelected(self.clayer)
        #    box = self.clayer.boundingBoxOfSelected()
        #    self.MainWindow.canvas.setExtent(self.clayer.extent())

    def listWidgetItemClicked(self, item, zoom=False):
        index = self.ui.listWidget.indexFromItem(item)
        if item.checkState() > 0:
            self.current_layer = self.vectors[index.row()]
        self.displayLayers(zoom)

    def listWidgetItemDoubleClicked(self):
        self.editLayerProperties()

    def listWidgetItemCurrentRowChanged(self):
        num_row = self.ui.listWidget.currentIndex().row()
        self.ui.pushButtonDelRaster.setEnabled(num_row > 5)

    def onCreateGeomFinished(self,geom,CurrentGeomTo,CurrentFeatureId):
        connection = self.connection
        cursor = connection.cursor()
        print ("CurrentFeatureId in")
        print (CurrentFeatureId)
        # return
        strgeomIn = ""
        strgeomOut = ""
        Ring = CurrentGeomTo.difference(geom)
        # if Ring is not None :

        # geometry In
        if geom.wkbType() == QGis.WKBPolygon:
            points = geom.asPolygon()
        if geom.wkbType() == QGis.WKBMultiPolygon:
            points = geom.asMultiPolygon()[0]
        if (len(points) >= 1):
            g = points[0]
            lastElement = g[-1]
            dim = len(g)
            i = 0
            for i in range(len(g)):
                y = g[i]
                if (i == 0):
                    strgeomIn += str(y[0]) + " " + str(y[1])
                else:
                    if (i == dim - 1):
                        continue
                    else:
                        strgeomIn += ", " + str(y[0]) + " " + str(y[1])
            y = g[0]
            strgeomIn = strgeomIn + "," + str(y[0]) + " " + str(y[1])
            wktIn = "POLYGON((" + strgeomIn + "))"
            num = ""

            # geometry Out
        if CurrentGeomTo.wkbType() == QGis.WKBPolygon:
            pts = CurrentGeomTo.asPolygon()
        if CurrentGeomTo.wkbType() == QGis.WKBMultiPolygon:
            pts = CurrentGeomTo.asMultiPolygon()[0]
        if (len(pts) >= 1):
            g = pts[0]
            lastElement = g[-1]
            dim = len(g)
            i = 0
            for i in range(len(g)):
                y = g[i]
                if (i == 0):
                    strgeomOut += str(y[0]) + " " + str(y[1])
                else:
                    if (i == dim - 1):
                        continue
                    else:
                        strgeomOut += ", " + str(y[0]) + " " + str(y[1])
            y = g[0]
            strgeomOut = strgeomOut + "," + str(y[0]) + " " + str(y[1])
            wktout = "POLYGON((" + strgeomOut + "),(" + strgeomIn + "))"
            # POLYGON((0 0, 10 0, 10 10, 0 10, 0 0),(1 1, 1 2, 2 2, 2 1, 1 1))
            num = ""

        print ("wktout OUT ")
        print (wktout)
        try:
            print ("update parcelle")
            cursor.execute(
                "UPDATE parcelle_d SET geom=(ST_GeomFromText(%s, "+str(globalvars.EPSG_SCR)+")), surface= ST_Area(%s) WHERE gid = (%s)",
                (wktout, wktout, int(CurrentFeatureId)))
            # exe = cursor.execute("INSERT INTO parcelle_d (numero,geom,surface)VALUES (%s, ST_GeomFromText(%s, 29702),ST_Area(%s)) returning gid,surface",(num, wktIn, wktIn))
            # cursor.execute("UPDATE parcelle_d SET ""geom=(SELECT ST_AsText(ST_Difference(ST_GeomFromText(%s, 29702),ST_GeomFromText(%s, 29702))) as geom), surface= ST_Area(%s)  WHERE gid = (%s) returning gid",(wktout,wktIn ,wktIn ,CurrentFeatureId))
            connection.commit()
        except StandardError as e:
            print (e)


        self.refreshCanvas()
        self.cLayer.commitChanges()
        self.cLayer.triggerRepaint()

        for layer in self.canvas.layers():
            if layer.type() == layer.VectorLayer:
                layer.removeSelection()
        self.canvas.refresh()
        self.reloadCanvas()

    def addRing(self):
        #self.MainWindow.canvas.zoomScale(1000)
        from RingTool import RingTool
        scale = self.MainWindow.canvas.scale()
        sender = 0
        parcelleDemande = self.registry.mapLayersByName("Demandes Parcelle")[0]
        print (" ------parcelleDemande-------")
        print (parcelleDemande)
        #return
        #self.MainWindow.canvas.setCurrentLayer(parcelleDemande)
        cLayer = self.MainWindow.canvas.currentLayer()
        #cLayer.startEditing()
        cp = RingTool(self.MainWindow.canvas, parcelleDemande, self.onCreateGeomFinished,2, self.MainWindow, None, sender,self)
        self.cpTool = cp
        self.MainWindow.canvas.setMapTool(cp)


            #self.MainWindow.canvas.setMapTool(self.LatLon)

    def CreateParcelle(self):

        #self.MainWindow.canvas.zoomScale(1000)
        scale = self.MainWindow.canvas.scale()
        print ("current scale")
        #print scale
        #dpi = self.mainWindow().physicalDpiX()
        #maxScalePerPixel = 156543.04
        #inchesPerMeter = 39.37
        #zoomlevel = int(round(math.log(((dpi * inchesPerMeter * maxScalePerPixel) / scale), 2), 0))
        #print zoomlevel

        cLayer = self.MainWindow.canvas.currentLayer()
        globalvars.CurrentLayer = 0
        sender = 0  # Pour savoir hoe avy any PLOF le creation Parcelle
        #iface.mapCanvas().snappingUtils().toggleEnabled()
        #QgsProject.instance().setSnapSettingsForLayer(cLayer.id(), True, 2, 0, 2, True)
        self.MainWindow.canvas.refresh()
        self.ui.actionEnregistrer.setEnabled(True)
        if(self.ParcelleCreux) :
            QMessageBox.critical(self.MainWindow.canvas, "Erreur", _fromUtf8("Veuillez terminer la construction: "))
        else:
            reply = QMessageBox.question(self.MainWindow, "Confirm",
                                             "Voulez-vous creer une parcelle pour une demande de Certificat?",
                                             QMessageBox.Yes | QMessageBox.No, QMessageBox.Yes)
            if reply == QMessageBox.Yes:
                item = self.ui.listWidget.item(0)
                self.ui.listWidget.setItemSelected(item, True)
                self.listWidgetItemClicked(item, False)
                parcelleDemande = self.registry.mapLayersByName("Demandes Parcelle")[0]
                self.MainWindow.canvas.setCurrentLayer(parcelleDemande)
                try:
                    cp = CaptureTool(self.MainWindow.canvas, parcelleDemande, self.onGeometryAdded,2, self.MainWindow, None, sender,self)
                    self.cpTool = cp
                    #self.MainWindow.canvas.setMapTool(cp)
                    if cp is not None :
                        print("CP is Not None")
                        if (isinstance(cp, str)):
                            print(" Capture tool erreur")
                            QMessageBox.critical(self.MainWindow.canvas, "Erreur",_fromUtf8("Problème d'outils de capture: "))
