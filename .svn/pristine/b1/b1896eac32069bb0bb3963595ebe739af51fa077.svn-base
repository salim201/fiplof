    def verifierFokontany(self):
        cursor = self.connection.cursor()
        print (" globalvars.id_commune ")
        print (globalvars.id_commune)
        useForm = 0
        try :
            print ("test")
            cursor.execute("SELECT *  FROM fokontany  WHERE idcommune=%s", [int(globalvars.id_commune)])
            dm = cursor.fetchall()
            size = len(dm)
            if (size >= 1):
                useForm = 1
            else:
                useForm = 0
            return useForm
        except StandardError as e:
            print (e)


        return useForm


    def commitParcelles(self,geometry):

        self.ui.actionValidate.setEnabled(False)
        strgeom = strgeomIn = ""
        layer_rec = self.parcelles
        print ("SELF.SENDER")
        print (self.sender)
        print (" self.geomPart IN")
        print (self.geomPart)
        #return


        sizearray = len(layer_rec)
        print ("IN COMMIT PARCELLE")
        try :
            if (sizearray >= 1):
                print
                "size sup a 1"
                z = layer_rec[0]
                for y in layer_rec:
                    if layer_rec[0] == y:
                        strgeom += str(y[0]) + " " + str(y[1])
                    else:
                        strgeom += ", " + str(y[0]) + " " + str(y[1])
                strgeom = strgeom + "," + str(z[0]) + " " + str(z[1])
                wkt = "POLYGON((" + strgeom + "))"
                print ("strGeom Inn")
                print (strgeom)
                if self.check_geom_equals(wkt):
                    QMessageBox.critical(self.MainWindow.canvas, u"Erreur", u" Geometrie déjà existante dans la table parcelle")
                else:
                    cur = self.connection.cursor()
                    try:
                        cur.execute("SELECT pd.gid FROM parcelle_d pd WHERE ST_Crosses(pd.geom::geometry, ST_GeomFromText(%s, "+str(globalvars.EPSG_SCR)+")) OR ST_Equals(pd.geom::geometry, ST_GeomFromText(%s, "+str(globalvars.EPSG_SCR)+")) ", (wkt,wkt))
                        res = cur.fetchall()
                        print (res)
                    except StandardError as e:
                        print (e)
                        QMessageBox.critical(self.MainWindow.canvas, "Erreur", " Geometry invalide")
                        self.connection.rollback()

                    if self.sender == 0:
                        exe = False
                        try:
                            num = '  '
                            wkt = "POLYGON((" + strgeom + "))"
                            connection = self.connection
                            cursor = connection.cursor()
                            print ("geompart")
                            print (self.geomPart)
                            print (len(self.geomPart))
                            print ("fin geompart")
                            if len(self.geomPart) == 0 :

                                exe = cursor.execute("INSERT INTO parcelle_d (numero,geom,surface,id_commune)VALUES (%s, ST_GeomFromText(%s, "+str(globalvars.EPSG_SCR)+"),ST_Area(%s), %s) returning gid,surface",(num, str(geometry.exportToWkt()), str(geometry.exportToWkt()), globalvars.id_commune))
                                #cursor.execute('insert into parcelle_d(numero, geom) values (%s, ST_GeomFromText(MULTIPOLYGON(%s)))',(num, wkt))
                                connection.commit()
                                dm = cursor.fetchone()
                                self.iddemande = dm[0]
                                self.idparcelle = dm[0]
                                self.currentGeomIdParcelle = dm[0]
                                self.currvalDemande = self.iddemande
                                self.msgBar = QgsMessageBar()
                                self.msgBar.pushMessage("Succes","Enregistrement parcelle avec succes", level=QgsMessageBar.SUCCESS)
                                cvs = self.MainWindow.canvas
                                cvs.scene().removeItem(self.cpTool.rubberBand)
                                cvs.scene().removeItem(self.cpTool.tempRubberBand)
