        Cf.setCustomProperty("labeling/fontSize", "8")
        # layer.setCustomProperty("labeling/fontWeight", "Bold")
        Cf.setCustomProperty("labeling/fieldName", 'numerocertificat')
        Cf.setCustomProperty("labeling/placement", "OverPoint")
        Cf.removeSelection()
        Cf.triggerRepaint()
        self.ui.actionEnregistrer.setEnabled(True)

        dgt = DigitizingTools(self.iface, self)
        dgt.splitFeature()
        #else :
