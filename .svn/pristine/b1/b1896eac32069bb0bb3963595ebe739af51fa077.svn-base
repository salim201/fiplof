        # type: (object, object, object, object, object, models.ProjetCouche) -> None
        if name is None or name == "":
            return None
        layer = QgsVectorLayer(name, "MAD", "ogr")
        print("isPlofPaps")
        print(isPlofPaps)
        if isPlofPaps == 1 :
            self.VFromPlofPaps = name
            self.Paps.append(layer)
            self.actionCommitParcelle.setEnabled(True)

            #self.allAlayer.append(layer)
            print("VECTEUR BASE")
            #print(layer)
        else :
            print("VECTEUR NOT BASE")
        print "load SHAPE epsg test"
        #crs = QgsCoordinateReferenceSystem(29702, QgsCoordinateReferenceSystem.EpsgCrsId)
        #layer.setCrs(crs)
        wkt = 'PROJCS["Madagascar_Laborde_Tan1925",GEOGCS["GCS_Tananarive_1925",DATUM["D_Tananarive_1925",SPHEROID["International_1924",6378388.0,297.0]],PRIMEM["Greenwich",0.0],UNIT["Degree",0.0174532925199433]],PROJECTION["Hotine_Oblique_Mercator_Azimuth_Center"],PARAMETER["False_Easting",400000.0],PARAMETER["False_Northing",800000.0],PARAMETER["Scale_Factor",0.9995],PARAMETER["Azimuth",18.9],PARAMETER["Longitude_Of_Center",46.43722917],PARAMETER["Latitude_Of_Center",-18.9],UNIT["Meter",1.0]]'
        #crs = QgsCoordinateReferenceSystem(wkt)
        crs = QgsCoordinateReferenceSystem(globalvars.EPSG_SCR, QgsCoordinateReferenceSystem.EpsgCrsId)
        layer.setCrs(crs)

        if not layer.isValid():
            print("Layer " + name + " is not valid shapefile")
            return None
        reg = QgsMapLayerRegistry.instance()
        reg.addMapLayer(layer)
        render_titre = layer.rendererV2()
        properties = {'color': '0,0,255,100', 'outline_color': '40,40,40,255', 'outline_width': '0.3'}
        if color != "":
            c1 = QtGui.QColor(color)
            c2 = c1.darker(150)
            r1 = str(c1.red()) + "," + str(c1.green()) + "," + str(c1.blue()) + ",100"
            r2 = str(c2.red()) + "," + str(c2.green()) + "," + str(c2.blue()) + ",255"
            if remplissage == 0 :
                properties = {'color': r1, 'outline_color': r2, 'outline_width': '0.3'}
            else :
                properties = {'color': '255,0,0,0', 'outline_color': r2, 'outline_width': '0.3'}
        my_symbol2 = QgsFillSymbolV2.createSimple(properties)
        if render_titre:
            render_titre.setSymbol(my_symbol2)
        if title == "":
            title = os.path.basename(str(name))
        self.addLayerToPanel(title, properties, couche_id, idprojet_commune)
        if obj:
            print(obj)
            print(obj.show_label)
            if obj.show_label:
                print(obj.label_name)
                layer.setCustomProperty("labeling", "pal")
                layer.setCustomProperty("labeling/fieldName", obj.label_name)
                layer.setCustomProperty("labeling/placement", "OverPoint")
                layer.setCustomProperty("labeling/enabled", "true")
                layer.setCustomProperty("labeling/fontFamily", obj.font)
                layer.setCustomProperty("labeling/fontSize", obj.font_size)
                layer.setCustomProperty("labeling/fontSizeInMapUnits", obj.font_size_map_unit)
                self.writeColor(layer, "labeling/textColor", QtGui.QColor(obj.font_color))
                layer.setCustomProperty("labeling/bufferDraw", obj.show_stroke)
                layer.setCustomProperty("labeling/bufferSize", obj.stroke_width)
                self.writeColor(layer, "labeling/bufferColor", QtGui.QColor(obj.stroke_color))
        self.vectors.append(layer)
        self.TitreShape = layer
        return QgsMapCanvasLayer(layer)

