    def loadGeom(self, layerProperty): #type: (LayerProperties) -> None
        uri = QgsDataSourceURI()
        uri.setConnection(db_config.db_host, db_config.db_port, db_config.db_name, db_config.db_user, db_config.db_pass)
        if layerProperty.dataSource.selectionCondition is not None:
            uri.setDataSource(layerProperty.dataSource.schema, layerProperty.dataSource.tableName, layerProperty.dataSource.geometryFieldName, layerProperty.dataSource.selectionCondition)
            print(layerProperty.dataSource.selectionCondition)
        else:
            uri.setDataSource(layerProperty.dataSource.schema, layerProperty.dataSource.tableName, layerProperty.dataSource.geometryFieldName)
        uri.setKeyColumn(layerProperty.dataSource.keyFieldName)
        layer = QgsVectorLayer(uri.uri(), layerProperty.name, "postgres")

        if not layer.isValid():
            #print "LAYER is not valide "+ where
            print ("\tFailed loading %s. Trying to set wkbtype and key column to %s" % (layerProperty.dataSource.tableName, layerProperty.dataSource.keyFieldName))
            uri.setWkbType(QGis.WKBPolygon)
            uri.setSrid(str(globalvars.EPSG_SCR))
            layer = QgsVectorLayer(uri.uri(), layerProperty.name, "postgres")
            if not layer.isValid():
                print("\t\tFailed loading %s even with wkbtype set" % layerProperty.dataSource.tableName)
                return None
        wkt = 'PROJCS["Madagascar_Laborde_Tan1925",GEOGCS["GCS_Tananarive_1925",DATUM["D_Tananarive_1925",SPHEROID["International_1924",6378388.0,297.0]],PRIMEM["Greenwich",0.0],UNIT["Degree",0.0174532925199433]],PROJECTION["Hotine_Oblique_Mercator_Azimuth_Center"],PARAMETER["False_Easting",400000.0],PARAMETER["False_Northing",800000.0],PARAMETER["Scale_Factor",0.9995],PARAMETER["Azimuth",18.9],PARAMETER["Longitude_Of_Center",46.43722917],PARAMETER["Latitude_Of_Center",-18.9],UNIT["Meter",1.0]]'
        #crs = QgsCoordinateReferenceSystem(wkt)
        crs = QgsCoordinateReferenceSystem(globalvars.EPSG_SCR, QgsCoordinateReferenceSystem.EpsgCrsId)
        layer.setCrs(crs)

        renderTitre = layer.rendererV2()
        mySymbol2 = QgsFillSymbolV2.createSimple(layerProperty.styles)
        if renderTitre:
            renderTitre.setSymbol(mySymbol2)
        layer.setCustomProperty("labeling/fieldName", layerProperty.dataSource.labelFieldName)
        layer.setCustomProperty("labeling/placement", "OverPoint")
        self.setLayerProperty(layer, layerProperty.index)
        layer.triggerRepaint()
        QgsMapLayerRegistry.instance().addMapLayer(layer)

        if layerProperty.isCurrent:
            print " at load current layer "
            self.clayer = layer
            self.MainWindow.canvas.setCurrentLayer(layer)
            self.MainWindow.canvas.zoomToSelected(layer)
        else:
            print " TITRES is_current_layer"
            self.Titres = layer
        self.addLayerToPanel(layerProperty.label, layerProperty.styles)

        self.vectors.append(layer)
        self.editionDemande = layer
        return QgsMapCanvasLayer(layer)

    def setLayerProperty(self, layer, layer_index):
        layer.setCustomProperty("labeling", "pal")
        layer.setCustomProperty("labeling/enabled", "true")
        layer.setCustomProperty("labeling/fontFamily", "Arial")
        layer.setCustomProperty("labeling/fontSize", "8")
        if layer_index is None:
            return
        cursor = self.connection.cursor(cursor_factory=psycopg2.extras.DictCursor)
        try:
            cursor.execute("SELECT * FROM param_layer WHERE layer_index = %s", (layer_index, ))
            res = cursor.fetchone()
            if res:
                layer.setCustomProperty("labeling/fontFamily", res["label_font"])
                layer.setCustomProperty("labeling/fontSize", res["label_size"])
                layer.setCustomProperty("labeling/fontSizeInMapUnits", res["font_size_map_units"]);
                self.writeColor(layer, "labeling/textColor", QtGui.QColor(res["label_color"]))
                layer.setCustomProperty("labeling/bufferDraw", res["stroke_size"] > 0)
                layer.setCustomProperty("labeling/bufferSize", res["stroke_size"])
                self.writeColor(layer, "labeling/bufferColor", QtGui.QColor(res["stroke_color"]))
        except Exception as e:
            print(e)
        cursor.close()

    def writeColor(self, layer, property, color):
        layer.setCustomProperty(property + "R", color.red())
        layer.setCustomProperty(property + "G", color.green())
        layer.setCustomProperty(property + "B", color.blue())

    def addLayerToPanel(self, label, properties={}, couche_id=0, idprojet_commune=0):
        item = QtGui.QListWidgetItem()
        item.setCheckState(QtCore.Qt.Checked) # Unchecked
        item.setFlags(item.flags() | Qt.ItemIsUserCheckable) # it.flags() & ~Qt.ItemIsSelectable
        #item.setEnabled(False)
        item.setText(label)
        icon = self.createPanelIcon(properties)
        item.setIcon(icon)
        item.setData(QtCore.Qt.UserRole, self.ui.listWidget.count())
        item.setData(QtCore.Qt.UserRole + 1, couche_id)
        item.setData(QtCore.Qt.UserRole + 2, idprojet_commune)
        self.ui.listWidget.addItem(item)

    def createPanelIcon(self, properties):
        icon = QtGui.QIcon()
        if 'type' in properties.keys() and properties['type'] == 'raster':
            icon.addPixmap(QtGui.QPixmap(":/sig/icone/map.png"), QtGui.QIcon.Normal, QtGui.QIcon.Off)
            return icon
        if 'type' in properties.keys() and properties['type'] == 'shape':
            icon.addPixmap(QtGui.QPixmap(":/sig/icone/layer-select.png"), QtGui.QIcon.Normal, QtGui.QIcon.Off)
            return icon
        pixmap = QtGui.QPixmap(32, 32)
        painter = QtGui.QPainter(pixmap)
        if 'outline_color' in properties.keys():
            pen = QPen()
            pen.setColor(self.colorFromStr(properties['outline_color']))
            painter.setPen(pen)
            painter.setBrush(self.colorFromStr(properties['outline_color']))
            painter.drawRect(0, 0, 32, 32)
            painter.setBrush(QtCore.Qt.white)
            painter.drawRect(1, 1, 30, 30)
        if 'color' in properties.keys():
            brush = QBrush(self.colorFromStr(properties['color']))
            if 'style' in properties.keys():
                if properties['style'] == 'b_diagonal':
                    brush.setStyle(Qt.BDiagPattern)
            painter.setBrush(brush)
            painter.drawRect(1, 1, 30, 30)

        painter.end()
        icon.addPixmap(pixmap)
        return icon

    def colorFromStr(self, s):
        t = s.split(',')
        return QColor(int(t[0]), int(t[1]), int(t[2]), int(t[3]))

    def verifierEmpietement(self,geom,layer,createOk):
        try :
            if layer is not None:
                for aFeat in layer.getFeatures(QgsFeatureRequest(geom.boundingBox())):
                    anId = aFeat.id()
                    aGeom = aFeat.geometry()
                    if geom.intersects(aGeom):
                        intersect = geom.intersection(aGeom)
                        try :
                            intersection_geometry = QgsGeometry(intersect)
                            if intersection_geometry.wkbType() == QGis.WKBPolygon:
                                createOk = 0
                                print " EMPIETEMENT SUR POLYGON "
                                QMessageBox.critical(self.MainWindow, "Erreur", "Empietement")
                                #self.balayerCanvas()
                                break
                            if intersection_geometry.wkbType() == QGis.WKBMultiPolygon:
                                QMessageBox.critical(self.MainWindow, "Erreur", "Empietement")
                                print " EMPIETEMENT SUR MULTIPOLYGON "
                                createOk = 0
                                #self.balayerCanvas()
                                break
                            if intersection_geometry.wkbType() == QGis.WKBLineString:
                                print " EMPIETEMENT SUR LINESTRING "
                                continue
                        except Exception as e:
                            print(e)
        except Exception as e:
            print(e)
        return createOk

