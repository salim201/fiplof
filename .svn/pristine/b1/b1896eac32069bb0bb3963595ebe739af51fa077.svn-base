        print "////////////////"
        print "Mandalo calcul itersection"
        print "io le izy:::::::"
        print "////////////////"
        print "Mandalo calcul itersection"
        print "io le izy:::::::"

        for layer in self.canvas.layers():
            if layer.type() == layer.VectorLayer:
                if layer is not None:
                    features = layer.getFeatures(QgsFeatureRequest().setFilterRect(geometrie.boundingBox()).setFlags(
                        QgsFeatureRequest.ExactIntersect))
                    tabGeometrie = []
                    for feature in features:
                        print "Un id = " + str(feature.id())
                        anId = feature.id()
                        aGeom = feature.geometry()
                        if geometrie.intersects(aGeom):
                            if geometrie.contains(aGeom):
                                inter = aGeom.intersection(geometrie)
                                geomDiff = geometrie.difference(aGeom)
                                geometrie = geomDiff
                                print "CONTAINS = " + str(anId)
                            else:
                                geomDiff = geometrie.difference(aGeom)
                                geometrie = geomDiff
                                print "intersects = " + str(anId)
                                # return geomDiff
                                # else:

                return geometrie
        #return geometrie

        #return None




