    def swipeLayer(self):
        from georeferencer.mapswipetool import MapSwipeTool

        #self.currentTool = self.currentTool
        layer = self.cLayer
        print ("rotote layer")
        print (self.GeorefLayer)
        print (layer)
        if self.GeorefLayer != None :
            self.currentTool = MapSwipeTool(self.canvas,self.GeorefLayer)
            #self.currentTool.setLayer(self.GeorefLayer)
            self.canvas.setMapTool(self.currentTool)
            if self.canvas.mapTool() != self.currentTool:
                self.prevTool = self.canvas.mapTool()
                self.canvas.setMapTool(self.currentTool)
            else:
                self.canvas.setMapTool(self.prevTool)

