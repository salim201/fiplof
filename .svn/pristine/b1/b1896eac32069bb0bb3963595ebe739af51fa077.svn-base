    def deleteLayer(self):
        print "test delete"
        selID = self.featureSelectId
        cLayer = self.cLayer
        connection = self.connection
        cursor = connection.cursor()


        if selID:
            cursor.execute("SELECT idcertificat from parcelle_d  WHERE  gid=%s", [int(selID)])
            try :
                dm = cursor.fetchone()
                if dm is not None :
                    if dm[0] is None:
                        print(self.featureSelectId)
                        if self.featureSelectId != "":
                            # reply = QMessageBox.question(self.MainWindow, "Confirm", "Voulez-vous supprimer la parcelle trace?",QMessageBox.Yes | QMessageBox.No, QMessageBox.Yes)
                            from Demande.ConfirmDelete import ConfirmDelete
                            confirm = ConfirmDelete(self.featureSelectId, self.connection)
                            reply = confirm.exec_()
                            print("REMOVE PARCELLE")
                            if reply :
                                try :

                                    cursor.execute("delete from proprietaireparcelle_d WHERE idparcelle=%s", [int(self.featureSelectId)])
                                    cursor.execute("delete from proprietaireparcelle WHERE idparcelle=%s",
                                                   [int(self.featureSelectId)])
                                    cursor.execute("delete from contribuables_parcelle WHERE idparcelle=%s",
                                                   [int(self.featureSelectId)])
                                    cursor.execute("delete from avoir_demande WHERE idparcelle=%s", [int(self.featureSelectId)])
                                    cursor.execute("delete from oppositions WHERE gid=%s", [int(self.featureSelectId)])
                                    cursor.execute("delete from demande WHERE gid=%s", [int(self.featureSelectId)])
                                    cursor.execute("delete from limitesparcelle WHERE idparcelle=%s", [int(self.featureSelectId)])
                                    cursor.execute("delete from parcelle_d WHERE gid=%s", [int(self.featureSelectId)])
                                except psycopg2.Error as e:
                                    self.connection.rollback()
                                connection.commit()
                                cLayer.deleteFeature(self.featureSelectId)
                                self.ui.actionEnregistrer.setEnabled(True)
                                self.featureSelectId = ""
                                canvas = self.MainWindow.canvas
                                canvas.unsetMapTool(self.tool_select_geometry)
                                cLayer.triggerRepaint()
                                for layer in canvas.layers():
                                    if layer.type() == layer.VectorLayer:
                                        layer.removeSelection()
                                canvas.refresh()
                                self.reloadCanvas()
                                self.currentGeomIdParcelle = 0

                                try:
                                    cursor.execute("SELECT * FROM commune WHERE idcommune = %s",
                                                     (globalvars.id_commune,))
                                    com = cursor.fetchone()
                                    currentValDemande = int(com[8])
                                except StandardError as e:
                                    print e

                                try:
                                    currentValDemande = currentValDemande - 1
                                    cursor.execute(
                                        "UPDATE commune SET cptdemande=(%s)  WHERE idcommune = (%s)",
                                        (int(currentValDemande), globalvars.id_commune))
                                    connection.commit()
                                except Exception as e:
                                    print(e)


                            else:
                                self.featureSelectId = ""
                                canvas = self.MainWindow.canvas
                                canvas.unsetMapTool(self.tool_select_geometry)
                        else:
                            QMessageBox.critical(self.MainWindow.canvas, "Erreur", "Veuillez entrer au moins choisir une parcelle ")
                    else:
                        QMessageBox.critical(self.MainWindow.canvas, "Erreur", "Suppression impossible")
                    self.ui.actionSelect.setChecked(False)
                else :
                    QMessageBox.critical(self.MainWindow.canvas, "Erreur", "Suppression impossible")
            except Exception as e:
                print(e)
        else:
            QMessageBox.critical(self.MainWindow.canvas, "Erreur", "Veuillez entrer au moins choisir une parcelle")

    def identifyCF(self):
        print "  identifyCF"
        gid = int(self.featureSelectId)
        connection = self.connection
        cursor = connection.cursor()
        cursor.execute("SELECT idcertificat   FROM parcelle_d  WHERE gid=%s", [gid])
        res = cursor.fetchone()
        return res

